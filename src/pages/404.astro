---
import BaseLayout from '../layouts/BaseLayout.astro'; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<BaseLayout title="Página no encontrada | El Mercadito de Chiloé" description="La página solicitada no existe." noindex={true}><section class="relative isolate grid min-h-[65vh] place-items-center overflow-hidden bg-cream px-5 py-16 text-center"><div class="absolute -left-20 top-10 -z-10 size-64 rounded-full bg-yellow/60 blur-3xl"></div><div class="max-w-3xl" data-reveal><p class="text-sm font-bold uppercase tracking-[.18em] text-terracotta">Error 404</p><p aria-hidden="true" class="mt-3 font-serif text-8xl leading-none text-forest/10 md:text-9xl">404</p><h1 class="-mt-2 font-serif text-5xl leading-none md:text-7xl">Esta ruta se perdió con la marea.</h1><p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-forest/70">La dirección puede haber cambiado. Continúa desde uno de estos lugares.</p><div class="mt-8 flex flex-wrap justify-center gap-3"><a class="rounded-full bg-forest px-6 py-4 font-bold text-white" href={`${base}/`}>Volver al inicio</a><a class="rounded-full bg-terracotta px-6 py-4 font-bold text-white" href={`${base}/carta/`}>Ver la carta</a><a class="rounded-full border border-forest/20 px-6 py-4 font-bold" href={`${base}/encuentranos/`}>Cómo llegar</a></div></div></section></BaseLayout>
