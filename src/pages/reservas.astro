---
import BaseLayout from '../layouts/BaseLayout.astro';
import SelectMenu from '../components/SelectMenu.astro';
import DatePicker from '../components/DatePicker.astro';
---
<BaseLayout title="Reservas | Mercadito de Chiloé"><section class="grid gap-12 bg-yellow px-6 py-24 md:grid-cols-2 md:px-[10vw] md:py-32"><div><p class="text-[11px] font-bold uppercase tracking-[.14em] text-orange">05 / Tu mesa</p><h1 class="mt-5 font-serif text-6xl leading-none tracking-[-.06em] md:text-8xl">La sobremesa<br /><i>empieza aquí.</i></h1><p class="mt-8 max-w-md text-lg leading-relaxed">Completa tus datos y te responderemos para confirmar disponibilidad.</p></div><form class="bg-paper p-8" action="mailto:hola@mercaditodechiloe.com" method="post" enctype="text/plain"><label class="mb-5 grid gap-2 text-xs font-bold">Nombre<input class="border-0 border-b border-ink/15 bg-transparent p-2 font-sans outline-none focus:border-orange" required name="nombre" type="text" /></label><label class="mb-5 grid gap-2 text-xs font-bold">Correo<input class="border-0 border-b border-ink/15 bg-transparent p-2 font-sans outline-none focus:border-orange" required name="correo" type="email" /></label><DatePicker name="fecha" label="Fecha" /><SelectMenu name="personas" label="Personas" options={['2 personas','3-4 personas','5-7 personas','8 o más personas']} /><button class="rounded bg-ink px-5 py-4 text-sm font-bold text-white" type="submit">Solicitar reserva ↗</button></form></section></BaseLayout>
