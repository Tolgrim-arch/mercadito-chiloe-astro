---
import BaseLayout from '../layouts/BaseLayout.astro'; import { restaurant } from '../data/restaurant';
---
<BaseLayout title="Reservas demo | El Mercadito de Chiloé"><section class="bg-yellow py-16 lg:py-24"><div class="mx-auto grid max-w-7xl gap-10 px-5 md:grid-cols-2 lg:px-8"><div data-reveal><p class="text-sm font-bold uppercase tracking-[.16em] text-terracotta">Demostración académica</p><h1 class="mt-4 font-serif text-[clamp(3.2rem,7vw,6rem)] leading-[.95] tracking-[-.05em]">Prueba un flujo de reserva.</h1><p class="mt-7 max-w-xl text-lg leading-relaxed"><strong>Este formulario no envía solicitudes ni confirma mesas.</strong> Para una reserva real usa el WhatsApp o teléfono oficial.</p><div class="mt-7 flex flex-wrap gap-3"><a class="rounded-full bg-forest px-6 py-4 font-bold text-white" href={restaurant.whatsapp} target="_blank" rel="noreferrer">WhatsApp oficial ↗</a><a class="rounded-full border border-forest/25 px-6 py-4 font-bold" href={restaurant.phoneHref}>{restaurant.phoneDisplay}</a></div></div><form data-demo-form class="rounded-3xl bg-paper p-6 shadow-xl md:p-8" novalidate><div data-form-fields><label class="grid gap-2 font-bold">Nombre<input class="min-h-12 rounded-xl border border-forest/20 bg-white px-4 font-normal" name="nombre" autocomplete="name" required /></label><label class="mt-5 grid gap-2 font-bold">Correo<input class="min-h-12 rounded-xl border border-forest/20 bg-white px-4 font-normal" name="correo" type="email" autocomplete="email" required /></label><div class="mt-5 grid gap-5 sm:grid-cols-2"><label class="grid gap-2 font-bold">Fecha<input class="min-h-12 rounded-xl border border-forest/20 bg-white px-4 font-normal" name="fecha" type="date" required /></label><label class="grid gap-2 font-bold">Personas<select class="min-h-12 rounded-xl border border-forest/20 bg-white px-4 font-normal" name="personas" required><option value="">Selecciona</option><option>2 personas</option><option>3–4 personas</option><option>5–7 personas</option><option>8 o más</option></select></label></div><p class="mt-4 min-h-6 text-sm font-bold text-terracotta" aria-live="polite" data-form-error></p><button class="mt-4 min-h-12 w-full rounded-full bg-terracotta px-6 font-bold text-white" type="submit">Revisar simulación</button></div><section class="hidden" data-form-summary aria-live="polite"><p class="text-sm font-bold uppercase tracking-wider text-terracotta">Resumen de demostración</p><h2 class="mt-3 font-serif text-4xl">Revisa los datos</h2><dl class="mt-6 grid gap-3" data-summary-list></dl><div class="mt-7 flex flex-wrap gap-3"><button class="rounded-full border border-forest/20 px-5 py-3 font-bold" type="button" data-edit>Editar</button><button class="rounded-full bg-forest px-5 py-3 font-bold text-white" type="button" data-complete>Completar simulación</button></div></section><section class="hidden" data-form-success tabindex="-1"><p class="text-sm font-bold uppercase tracking-wider text-terracotta">Simulación completada</p><h2 class="mt-3 font-serif text-4xl">No se ha reservado una mesa.</h2><p class="mt-4 leading-relaxed text-forest/70">La demostración terminó sin enviar ni guardar tus datos.</p><button class="mt-7 rounded-full bg-forest px-5 py-3 font-bold text-white" type="button" data-reset>Probar de nuevo</button></section></form></div></section><script>const initForm=()=>{const form=document.querySelector('[data-demo-form]');if(!(form instanceof HTMLFormElement)||form.dataset.ready)return;form.dataset.ready='1';const fields=form.querySelector('[data-form-fields]');const summary=form.querySelector('[data-form-summary]');const success=form.querySelector('[data-form-success]');const error=form.querySelector('[data-form-error]');const list=form.querySelector('[data-summary-list]');const date=form.elements.namedItem('fecha');if(date instanceof HTMLInputElement)date.min=new Date().toISOString().slice(0,10);form.addEventListener('submit',e=>{e.preventDefault();if(!form.checkValidity()){if(error)error.textContent='Completa correctamente todos los campos.';form.reportValidity();return}const data=new FormData(form);if(list)list.innerHTML=[['Nombre',data.get('nombre')],['Correo',data.get('correo')],['Fecha',data.get('fecha')],['Personas',data.get('personas')]].map(([k,v])=>`<div class="flex justify-between gap-4 border-b border-forest/15 pb-2"><dt class="font-bold">${k}</dt><dd>${v}</dd></div>`).join('');fields?.classList.add('hidden');summary?.classList.remove('hidden')});form.querySelector('[data-edit]')?.addEventListener('click',()=>{summary?.classList.add('hidden');fields?.classList.remove('hidden')});form.querySelector('[data-complete]')?.addEventListener('click',()=>{summary?.classList.add('hidden');success?.classList.remove('hidden');if(success instanceof HTMLElement)success.focus()});form.querySelector('[data-reset]')?.addEventListener('click',()=>{form.reset();success?.classList.add('hidden');fields?.classList.remove('hidden')})};document.addEventListener('astro:page-load',initForm);initForm();</script></BaseLayout>
