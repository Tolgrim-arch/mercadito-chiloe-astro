---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<BaseLayout title="El lugar | El Mercadito de Chiloé" description="Conoce el ambiente y la propuesta gastronómica de El Mercadito de Chiloé, restaurante ubicado en Castro.">
  <section class="bg-cream py-16 lg:py-24"><div class="mx-auto grid max-w-7xl items-center gap-10 px-5 md:grid-cols-2 lg:px-8"><div data-reveal><p class="text-sm font-bold uppercase tracking-[.16em] text-terracotta">El lugar</p><h1 class="mt-4 font-serif text-[clamp(3.2rem,7vw,6rem)] leading-[.95] tracking-[-.05em]">Una cocina con carácter chilote.</h1><p class="mt-7 max-w-xl text-lg leading-relaxed text-forest/70">El Mercadito reúne cocina, barrio, vistas y un interior construido con objetos que cuentan historias.</p></div><ResponsiveImage name="plato-02" class="aspect-[4/3] w-full rounded-[2.5rem] object-cover" alt="Muro interior de El Mercadito decorado con ilustraciones y platos" width={768} height={1024} loading="eager" /></div></section>
  <section class="mx-auto grid max-w-7xl gap-12 px-5 py-20 md:grid-cols-2 lg:px-8"><ResponsiveImage name="plato-01" class="aspect-[4/3] w-full rounded-3xl object-cover" alt="Botes de madera en la costa de Chiloé" width={1024} height={768} /><div data-reveal><p class="text-sm font-bold uppercase tracking-[.16em] text-terracotta">Chiloé en la mesa</p><h2 class="mt-3 font-serif text-4xl md:text-6xl">Mar, huerta y cocina de temporada.</h2><p class="mt-6 text-lg leading-relaxed text-forest/70">La carta oficial recorre pescados, mariscos, preparaciones para compartir, platos del huerto y una selección de bebidas del sur. El resultado es una cocina cercana, expresiva y ligada al territorio.</p><div class="mt-8 flex flex-wrap gap-3"><a class="inline-flex min-h-12 items-center rounded-full bg-terracotta px-6 font-bold text-white hover:-translate-y-0.5 hover:bg-terracotta-dark" href={`${base}/carta/`}>Ver la carta</a><a class="inline-flex min-h-12 items-center rounded-full border border-forest/20 px-6 font-bold hover:border-terracotta hover:text-terracotta" href={`${base}/planifica-tu-visita/`}>Planifica tu visita</a><a class="inline-flex min-h-12 items-center rounded-full bg-forest px-6 font-bold text-white hover:-translate-y-0.5 hover:bg-terracotta" href={`${base}/encuentranos/`}>Cómo llegar</a></div></div></section>
</BaseLayout>
