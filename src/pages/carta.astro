---
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredDishes, restaurant } from '../data/restaurant';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const images=['exterior-01.jpg','ambiente-01.jpg','plato-04.jpg'];
---
<BaseLayout title="Carta | El Mercadito de Chiloé">
  <section class="bg-forest py-16 text-white lg:py-24"><div class="mx-auto max-w-7xl px-5 lg:px-8" data-reveal><p class="text-sm font-bold uppercase tracking-[.16em] text-yellow">Carta oficial</p><h1 class="mt-4 max-w-4xl font-serif text-[clamp(3.2rem,7vw,6rem)] leading-[.95] tracking-[-.05em]">Del mar, del campo y del fuego.</h1><p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/70">Una selección comprobada de la carta. Consulta siempre la versión oficial para disponibilidad y cambios.</p><a class="mt-7 inline-flex min-h-12 items-center rounded-full bg-yellow px-6 font-bold text-forest" href={restaurant.officialMenu} target="_blank" rel="noreferrer">Abrir carta oficial ↗</a></div></section>
  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <div class="mb-8 flex flex-wrap gap-2" data-filters data-no-print><button class="rounded-full bg-forest px-5 py-3 font-bold text-white" type="button" aria-pressed="true" data-filter="Todos">Todos</button><button class="rounded-full border border-forest/20 px-5 py-3 font-bold" type="button" aria-pressed="false" data-filter="Del mar">Del mar</button><button class="rounded-full border border-forest/20 px-5 py-3 font-bold" type="button" aria-pressed="false" data-filter="Para picotear">Para picotear</button></div>
    <p class="mb-5 text-sm text-forest/60" aria-live="polite" data-filter-status>3 platos visibles</p>
    <div class="grid gap-6 md:grid-cols-3">{featuredDishes.map((dish,i)=><article data-reveal data-category={dish.category} class="overflow-hidden rounded-3xl border border-forest/10 bg-white shadow-sm"><img class="aspect-[4/3] w-full object-cover" src={`${base}/images/mercadito/${images[i]}`} alt={`Presentación gastronómica de ${dish.name}`} width="835" height="936" loading={i===0?'eager':'lazy'} /><div class="p-6"><p class="text-xs font-bold uppercase tracking-wider text-terracotta">{dish.category}</p><h2 class="mt-2 font-serif text-3xl">{dish.name}</h2><p class="mt-3 leading-relaxed text-forest/70">{dish.description}</p><div class="mt-6 flex items-center justify-between"><strong class="text-lg">{dish.price}</strong><button class="min-h-11 rounded-full border border-forest/20 px-4 font-bold transition hover:border-terracotta hover:text-terracotta" type="button" data-dish-open={dish.slug}>Ver detalle</button></div></div></article>)}</div>
    <p class="mt-8 text-sm text-forest/55">{restaurant.sourceNote} Precios sujetos a cambios.</p>
  </section>
  {featuredDishes.map(dish=><dialog class="m-auto max-w-xl rounded-3xl bg-paper p-0 text-forest shadow-2xl backdrop:bg-forest/70" data-dish-dialog={dish.slug}><div class="p-7"><div class="flex items-start justify-between gap-5"><div><p class="text-xs font-bold uppercase tracking-wider text-terracotta">{dish.category}</p><h2 class="mt-2 font-serif text-4xl">{dish.name}</h2></div><button class="grid size-11 place-items-center rounded-full border border-forest/20" type="button" data-dish-close aria-label={`Cerrar detalle de ${dish.name}`}>×</button></div><p class="mt-5 text-lg leading-relaxed text-forest/70">{dish.description}</p><strong class="mt-6 block text-xl">{dish.price}</strong><p class="mt-5 text-sm text-forest/55">Información consultada en la carta oficial.</p></div></dialog>)}
  <script>
    const initCarta=()=>{const buttons=document.querySelectorAll('[data-filter]');const cards=document.querySelectorAll('[data-category]');const status=document.querySelector('[data-filter-status]');const apply=(value)=>{let count=0;cards.forEach(card=>{const show=value==='Todos'||card.getAttribute('data-category')===value;card.classList.toggle('hidden',!show);if(show)count++});buttons.forEach(button=>{const active=button.getAttribute('data-filter')===value;button.setAttribute('aria-pressed',String(active));button.classList.toggle('bg-forest',active);button.classList.toggle('text-white',active)});if(status)status.textContent=`${count} ${count===1?'plato visible':'platos visibles'}`;const url=new URL(location.href);value==='Todos'?url.searchParams.delete('categoria'):url.searchParams.set('categoria',value);history.replaceState({},'',url)};buttons.forEach(button=>{if(button.getAttribute('data-ready'))return;button.setAttribute('data-ready','1');button.addEventListener('click',()=>apply(button.getAttribute('data-filter')||'Todos'))});const initial=new URL(location.href).searchParams.get('categoria');if(initial&&[...buttons].some(b=>b.getAttribute('data-filter')===initial))apply(initial);document.querySelectorAll('[data-dish-open]').forEach(button=>{if(!(button instanceof HTMLButtonElement)||button.dataset.ready)return;button.dataset.ready='1';button.addEventListener('click',()=>{const dialog=document.querySelector(`[data-dish-dialog="${button.dataset.dishOpen}"]`);if(dialog instanceof HTMLDialogElement)dialog.showModal()})});document.querySelectorAll('[data-dish-close]').forEach(button=>button.addEventListener('click',()=>button.closest('dialog')?.close()));document.querySelectorAll('dialog').forEach(dialog=>dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close()}))};document.addEventListener('astro:page-load',initCarta);initCarta();
  </script>
</BaseLayout>
