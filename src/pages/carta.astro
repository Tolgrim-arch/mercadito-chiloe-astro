---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';
import { featuredDishes, restaurant } from '../data/restaurant';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const images=['exterior-01.jpg','ambiente-01.jpg','plato-04.jpg'];
---
<BaseLayout title="Carta | El Mercadito de Chiloé" description="Explora una selección de platos y precios de la carta oficial de El Mercadito de Chiloé en Castro.">
  <section class="bg-forest py-16 text-white lg:py-24" id="carta-inicio"><div class="mx-auto max-w-7xl px-5 lg:px-8" data-reveal><p class="text-sm font-bold uppercase tracking-[.16em] text-yellow">Carta oficial</p><h1 class="mt-4 max-w-4xl font-serif text-[clamp(3.2rem,7vw,6rem)] leading-[.95] tracking-[-.05em]">Del mar, del campo y del fuego.</h1><p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/70">Una selección comprobada de la carta. Consulta siempre la versión oficial para disponibilidad y cambios.</p><a class="mt-7 inline-flex min-h-12 items-center rounded-full bg-yellow px-6 font-bold text-forest hover:-translate-y-0.5" href={restaurant.officialMenu} target="_blank" rel="noreferrer">Abrir carta oficial ↗</a></div></section>
  <SectionNav items={[{href:'#seleccion',label:'Selección'},{href:'#nota-carta',label:'Información'}]} />
  <section id="seleccion" class="mx-auto max-w-7xl scroll-mt-36 px-5 py-20 lg:px-8">
    <div class="mb-8 flex flex-wrap gap-2" data-filters data-no-print><button class="min-h-11 rounded-full bg-forest px-5 py-3 font-bold text-white" type="button" aria-pressed="true" data-filter="Todos">Todos</button><button class="min-h-11 rounded-full border border-forest/20 px-5 py-3 font-bold hover:border-terracotta" type="button" aria-pressed="false" data-filter="Del mar">Del mar</button><button class="min-h-11 rounded-full border border-forest/20 px-5 py-3 font-bold hover:border-terracotta" type="button" aria-pressed="false" data-filter="Para picotear">Para picotear</button></div>
    <p class="mb-5 text-sm text-forest/60" aria-live="polite" data-filter-status>3 platos visibles</p>
    <div class="grid gap-6 md:grid-cols-3">{featuredDishes.map((dish,i)=><article data-reveal data-category={dish.category} class="overflow-hidden rounded-3xl border border-forest/10 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-xl"><img class="aspect-[4/3] w-full object-cover" src={`${base}/images/mercadito/${images[i]}`} alt={`Presentación gastronómica de ${dish.name}`} width="835" height="936" loading={i===0?'eager':'lazy'} decoding="async" /><div class="p-6"><p class="text-xs font-bold uppercase tracking-wider text-terracotta">{dish.category}</p><h2 class="mt-2 font-serif text-3xl">{dish.name}</h2><p class="mt-3 leading-relaxed text-forest/70">{dish.description}</p><div class="mt-6 flex items-center justify-between gap-4"><strong class="text-lg">{dish.price}</strong><button class="min-h-11 rounded-full border border-forest/20 px-4 font-bold hover:border-terracotta hover:text-terracotta" type="button" data-dish-open={dish.slug}>Ver detalle</button></div></div></article>)}</div>
    <p id="nota-carta" class="mt-8 scroll-mt-36 text-sm text-forest/55">{restaurant.sourceNote} Precios sujetos a cambios.</p>
  </section>
  {featuredDishes.map((dish,i)=><dialog aria-labelledby={`titulo-${dish.slug}`} class="m-auto w-[min(92vw,40rem)] overflow-hidden rounded-3xl bg-paper p-0 text-forest shadow-2xl backdrop:bg-forest/70" data-dish-dialog={dish.slug}><img class="aspect-[16/8] w-full object-cover" src={`${base}/images/mercadito/${images[i]}`} alt={`Presentación gastronómica de ${dish.name}`} width="835" height="936" loading="lazy" decoding="async" /><div class="p-7"><div class="flex items-start justify-between gap-5"><div><p class="text-xs font-bold uppercase tracking-wider text-terracotta">{dish.category}</p><h2 id={`titulo-${dish.slug}`} class="mt-2 font-serif text-4xl">{dish.name}</h2></div><button class="grid size-11 shrink-0 place-items-center rounded-full border border-forest/20 text-2xl hover:border-terracotta hover:text-terracotta" type="button" data-dish-close aria-label={`Cerrar detalle de ${dish.name}`}>×</button></div><p class="mt-5 text-lg leading-relaxed text-forest/70">{dish.description}</p><strong class="mt-6 block text-xl">{dish.price}</strong><p class="mt-5 text-sm text-forest/55">{restaurant.sourceNote}</p></div></dialog>)}
  <script>
    const initCarta=()=>{const buttons=document.querySelectorAll('[data-filter]');const cards=document.querySelectorAll('[data-category]');const status=document.querySelector('[data-filter-status]');const apply=(value)=>{let count=0;cards.forEach(card=>{const show=value==='Todos'||card.getAttribute('data-category')===value;card.classList.toggle('hidden',!show);if(show)count++});buttons.forEach(button=>{const active=button.getAttribute('data-filter')===value;button.setAttribute('aria-pressed',String(active));button.classList.toggle('bg-forest',active);button.classList.toggle('text-white',active)});if(status)status.textContent=`${count} ${count===1?'plato visible':'platos visibles'}`;const url=new URL(location.href);value==='Todos'?url.searchParams.delete('categoria'):url.searchParams.set('categoria',value);history.replaceState({},'',url)};buttons.forEach(button=>{if(!(button instanceof HTMLButtonElement)||button.dataset.ready)return;button.dataset.ready='1';button.addEventListener('click',()=>apply(button.dataset.filter||'Todos'))});const initial=new URL(location.href).searchParams.get('categoria');if(initial&&[...buttons].some(b=>b.getAttribute('data-filter')===initial))apply(initial);document.querySelectorAll('[data-dish-dialog]').forEach(dialog=>{if(!(dialog instanceof HTMLDialogElement)||dialog.dataset.ready)return;dialog.dataset.ready='1';let opener=null;document.querySelector(`[data-dish-open="${dialog.dataset.dishDialog}"]`)?.addEventListener('click',event=>{opener=event.currentTarget;dialog.showModal()});dialog.querySelector('[data-dish-close]')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});dialog.addEventListener('close',()=>{if(opener instanceof HTMLElement)opener.focus()})})};document.addEventListener('astro:page-load',initCarta);initCarta();
  </script>
</BaseLayout>
