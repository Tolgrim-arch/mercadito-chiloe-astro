---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';
import { dishes, restaurant } from '../data/restaurant';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = ['Todos', 'Para picotear', 'Del mar', 'Del campo', 'Postres y bebidas'];
---
<BaseLayout title="Carta | El Mercadito de Chiloé" description="Explora la carta de El Mercadito de Chiloé en Castro: picoteos del archipiélago, curanto, chupe, pesca artesanal y recetas patrimoniales.">
  <section class="bg-forest py-16 text-white lg:py-24" id="carta-inicio">
    <div class="mx-auto max-w-7xl px-5 lg:px-8" data-reveal>
      <p class="text-sm font-bold uppercase tracking-[.16em] text-yellow">Carta oficial</p>
      <h1 class="mt-4 max-w-4xl font-serif text-[clamp(3.2rem,7vw,6rem)] leading-[.95] tracking-[-.05em]">Del mar, del campo y del fuego.</h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/70">Una selección auténtica de nuestra propuesta gastronómica en Castro. Consulta siempre la carta digital oficial de Fudo para disponibilidad diaria y actualizaciones.</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a class="inline-flex min-h-12 items-center rounded-full bg-yellow px-6 font-bold text-forest transition hover:-translate-y-0.5 hover:bg-yellow/90" href={restaurant.officialMenu} target="_blank" rel="noreferrer">Abrir carta oficial en Fudo ↗</a>
        <a class="inline-flex min-h-12 items-center rounded-full border border-white/20 px-6 font-bold text-white transition hover:border-yellow hover:text-yellow" href={`${base}/reservas/`}>Demostración de reserva</a>
      </div>
    </div>
  </section>

  <SectionNav items={[{href:'#seleccion',label:'Carta completa'},{href:'#nota-carta',label:'Información y procedencia'}]} />

  <section id="seleccion" class="mx-auto max-w-7xl scroll-mt-36 px-5 py-16 lg:px-8">
    <div class="mb-8 flex flex-wrap gap-2" data-filters data-no-print aria-label="Filtrar por categoría">
      {categories.map((cat, index) => (
        <button
          class:list={[
            "min-h-11 rounded-full px-5 py-2.5 text-sm font-bold transition hover:border-terracotta",
            index === 0 ? "bg-forest text-white" : "border border-forest/20 text-forest hover:bg-cream"
          ]}
          type="button"
          aria-pressed={index === 0 ? "true" : "false"}
          data-filter={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <p class="mb-6 text-sm font-semibold text-forest/70" aria-live="polite" data-filter-status>{dishes.length} preparaciones disponibles</p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {dishes.map((dish, i) => (
        <article data-reveal data-category={dish.category} class="flex flex-col justify-between overflow-hidden rounded-3xl border border-forest/10 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
          {dish.image && (
            <div class="relative overflow-hidden bg-cream">
              <img
                class="aspect-[4/3] w-full object-cover transition duration-500 hover:scale-105"
                src={`${base}/images/mercadito/${dish.image}`}
                alt={dish.imageAlt || `Fotografía representativa de ${dish.name}`}
                width="835"
                height="626"
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
              {dish.dietary && (
                <span class="absolute bottom-3 left-3 rounded-full bg-forest/90 px-3 py-1 text-xs font-bold text-white backdrop-blur-sm">
                  {dish.dietary}
                </span>
              )}
            </div>
          )}
          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-terracotta">{dish.category}</p>
              <h2 class="mt-2 font-serif text-2xl font-medium">{dish.name}</h2>
              <p class="mt-3 text-sm leading-relaxed text-forest/75">{dish.description}</p>
            </div>
            <div class="mt-6 flex items-center justify-between gap-4 border-t border-forest/10 pt-4">
              <strong class="font-serif text-xl font-bold text-forest">{dish.price}</strong>
              <button
                class="inline-flex min-h-10 items-center rounded-full border border-forest/25 px-4 text-xs font-bold text-forest transition hover:border-terracotta hover:bg-terracotta hover:text-white"
                type="button"
                data-dish-open={dish.slug}
                aria-haspopup="dialog"
              >
                Ver detalle
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div id="nota-carta" class="mt-12 scroll-mt-36 rounded-2xl border border-forest/15 bg-cream/70 p-6 text-sm text-forest/75">
      <p class="font-bold text-forest">Sobre los valores e ingredientes:</p>
      <p class="mt-1">{restaurant.sourceNote} La disponibilidad de productos marinos está sujeta a la pesca artesanal y temporadas de veda en el archipiélago de Chiloé. Los precios pueden cambiar sin previo aviso.</p>
    </div>
  </section>

  {dishes.map((dish) => (
    <dialog aria-labelledby={`titulo-${dish.slug}`} class="m-auto w-[min(92vw,40rem)] overflow-hidden rounded-3xl bg-paper p-0 text-forest shadow-2xl backdrop:bg-forest/70 backdrop:backdrop-blur-sm" data-dish-dialog={dish.slug}>
      {dish.image && (
        <img
          class="aspect-[16/8] w-full object-cover"
          src={`${base}/images/mercadito/${dish.image}`}
          alt={dish.imageAlt || `Detalle de ${dish.name}`}
          width="835"
          height="418"
          loading="lazy"
          decoding="async"
        />
      )}
      <div class="p-7">
        <div class="flex items-start justify-between gap-5">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <p class="text-xs font-bold uppercase tracking-wider text-terracotta">{dish.category}</p>
              {dish.dietary && <span class="rounded-full bg-cream px-2.5 py-0.5 text-[11px] font-bold text-forest">{dish.dietary}</span>}
            </div>
            <h2 id={`titulo-${dish.slug}`} class="mt-2 font-serif text-3xl font-medium">{dish.name}</h2>
          </div>
          <button class="grid size-11 shrink-0 place-items-center rounded-full border border-forest/20 text-2xl transition hover:border-terracotta hover:bg-terracotta hover:text-white" type="button" data-dish-close aria-label={`Cerrar detalle de ${dish.name}`}>×</button>
        </div>
        <p class="mt-5 text-base leading-relaxed text-forest/80">{dish.description}</p>
        <div class="mt-6 flex items-baseline justify-between border-t border-forest/15 pt-4">
          <div>
            <span class="text-xs font-semibold text-forest/60">Precio de referencia:</span>
            <strong class="block font-serif text-2xl font-bold text-forest">{dish.price}</strong>
          </div>
          <a class="inline-flex min-h-11 items-center rounded-full bg-forest px-5 text-xs font-bold text-white transition hover:bg-terracotta" href={restaurant.officialMenu} target="_blank" rel="noreferrer">Ver en carta digital ↗</a>
        </div>
        <p class="mt-5 text-xs text-forest/55">{restaurant.sourceNote}</p>
      </div>
    </dialog>
  ))}

  <script>
    const initCarta = () => {
      const buttons = document.querySelectorAll('[data-filter]');
      const cards = document.querySelectorAll('[data-category]');
      const status = document.querySelector('[data-filter-status]');

      const apply = (value) => {
        let count = 0;
        cards.forEach((card) => {
          const show = value === 'Todos' || card.getAttribute('data-category') === value;
          card.classList.toggle('hidden', !show);
          if (show) {
            count++;
            card.setAttribute('data-reveal-visible', '');
          }
        });

        buttons.forEach((button) => {
          const active = button.getAttribute('data-filter') === value;
          button.setAttribute('aria-pressed', String(active));
          button.classList.toggle('bg-forest', active);
          button.classList.toggle('text-white', active);
          button.classList.toggle('border', !active);
          button.classList.toggle('border-forest/20', !active);
          button.classList.toggle('text-forest', !active);
        });

        if (status) status.textContent = `${count} ${count === 1 ? 'preparación disponible' : 'preparaciones disponibles'}`;

        const url = new URL(location.href);
        if (value === 'Todos') url.searchParams.delete('categoria');
        else url.searchParams.set('categoria', value);
        history.replaceState({}, '', url);
      };

      buttons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement) || button.dataset.ready) return;
        button.dataset.ready = '1';
        button.addEventListener('click', () => apply(button.dataset.filter || 'Todos'));
      });

      const initial = new URL(location.href).searchParams.get('categoria');
      if (initial && [...buttons].some((b) => b.getAttribute('data-filter') === initial)) {
        apply(initial);
      }

      document.querySelectorAll('[data-dish-dialog]').forEach((dialog) => {
        if (!(dialog instanceof HTMLDialogElement) || dialog.dataset.ready) return;
        dialog.dataset.ready = '1';
        let opener = null;
        document.querySelector(`[data-dish-open="${dialog.dataset.dishDialog}"]`)?.addEventListener('click', (event) => {
          opener = event.currentTarget;
          dialog.showModal();
        });
        dialog.querySelector('[data-dish-close]')?.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });
        dialog.addEventListener('close', () => {
          if (opener instanceof HTMLElement) opener.focus();
        });
      });
    };

    document.addEventListener('astro:page-load', initCarta);
    initCarta();
  </script>
</BaseLayout>