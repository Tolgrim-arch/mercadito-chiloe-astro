---
import BaseLayout from '../layouts/BaseLayout.astro';
const items=[['Curanto en olla','Mariscos, carnes y papas chilotas','$18.900'],['Salmón de la isla','Cocción lenta, nalca y caldo ahumado','$21.900'],['Papas nativas','Mantequilla de ajo chilote y merkén','$7.900'],['Milcao dorado','Crema ácida, cebolla encurtida y hierbas','$8.500'],['Chupe de jaiba','Pan tostado, queso de campo y perejil','$14.900'],['Kuchen de murta','Crema tibia y fruta de estación','$6.900']];
---
<BaseLayout title="La carta | Mercadito de Chiloé"><section class="bg-cream px-6 py-24 md:px-[10vw] md:py-32"><p class="text-[11px] font-bold uppercase tracking-[.14em] text-orange">02 / La carta</p><h1 class="mt-5 font-serif text-6xl leading-none tracking-[-.06em] md:text-8xl">Del mar, del campo<br />y del <i class="text-orange">fuego.</i></h1><p class="mt-8 max-w-xl text-lg text-ink/70">Una carta breve que cambia con la temporada y con lo que llega fresco a la isla.</p></section><section class="px-6 py-24 md:px-[10vw]"><p class="text-[11px] font-bold uppercase tracking-[.14em] text-orange">Para compartir y quedarse</p><h2 class="mt-5 font-serif text-5xl leading-none tracking-[-.05em] md:text-7xl">Lo que estamos<br /><i class="text-orange">cocinando hoy.</i></h2><div class="mt-12 max-w-4xl">{items.map(([name,note,price])=><article class="flex items-center justify-between gap-5 border-b border-ink/15 py-6"><div><h3 class="font-serif text-2xl">{name}</h3><p class="mt-1 text-sm text-ink/55">{note}</p></div><strong class="text-orange">{price}</strong></article>)}</div></section></BaseLayout>
