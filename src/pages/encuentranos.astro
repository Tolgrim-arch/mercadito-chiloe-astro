---
import BaseLayout from '../layouts/BaseLayout.astro'; import { restaurant } from '../data/restaurant'; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<BaseLayout title="Cómo llegar | El Mercadito de Chiloé"><section class="bg-cream py-16 lg:py-24"><div class="mx-auto max-w-7xl px-5 lg:px-8" data-reveal><p class="text-sm font-bold uppercase tracking-[.16em] text-terracotta">Cómo llegar</p><h1 class="mt-4 max-w-4xl font-serif text-[clamp(3.2rem,7vw,6rem)] leading-[.95] tracking-[-.05em]">Nos vemos en Pedro Montt 210.</h1><p class="mt-7 max-w-2xl text-lg leading-relaxed text-forest/70">Encuentra el restaurante, revisa los horarios y abre la ubicación exacta en Google Maps.</p></div></section><section class="mx-auto grid max-w-7xl gap-10 px-5 py-20 md:grid-cols-2 lg:px-8"><div data-reveal><p class="text-xs font-bold uppercase tracking-wider text-terracotta">Dirección oficial</p><h2 class="mt-3 font-serif text-4xl">{restaurant.address}</h2><button class="mt-5 min-h-11 rounded-full border border-forest/20 px-5 font-bold" type="button" data-copy-address data-address={restaurant.address}>Copiar dirección</button><p class="mt-2 min-h-6 text-sm text-forest/60" aria-live="polite" data-copy-status></p><div class="mt-8 space-y-3">{restaurant.hours.map(({days,times})=><p class="flex flex-wrap justify-between gap-3 border-b border-forest/15 pb-3"><strong>{days}</strong><span>{times}</span></p>)}</div><div class="mt-8 flex flex-wrap gap-3"><a class="rounded-full bg-forest px-6 py-4 font-bold text-white" href={restaurant.maps} target="_blank" rel="noreferrer">Abrir Google Maps ↗</a><a class="rounded-full border border-forest/20 px-6 py-4 font-bold" href={restaurant.phoneHref}>{restaurant.phoneDisplay}</a></div><p class="mt-6 text-xs text-forest/55">{restaurant.sourceNote}</p></div><div data-reveal class="overflow-hidden rounded-3xl bg-forest text-white"><div class="grid min-h-[420px] place-items-center p-8 text-center" data-map-placeholder><div><p class="font-serif text-4xl">Mapa del restaurante</p><p class="mx-auto mt-4 max-w-sm text-white/70">El mapa se carga sólo cuando lo solicitas. La ubicación externa siempre permanece disponible.</p><button class="mt-6 min-h-12 rounded-full bg-yellow px-6 font-bold text-forest" type="button" data-load-map>Cargar mapa</button></div></div></div></section><section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8"><img data-reveal class="aspect-[16/7] w-full rounded-3xl object-cover" src={`${base}/images/mercadito/plato-01.jpg`} alt="Botes tradicionales en la costa de Chiloé" width="1024" height="768" loading="lazy" /></section><script>const initMap=()=>{const button=document.querySelector('[data-load-map]');const holder=document.querySelector('[data-map-placeholder]');if(!(button instanceof HTMLButtonElement)||!(holder instanceof HTMLElement)||button.dataset.ready)return;button.dataset.ready='1';button.addEventListener('click',()=>{const iframe=document.createElement('iframe');iframe.title='Mapa de El Mercadito de Chiloé';iframe.loading='lazy';iframe.className='h-[420px] w-full border-0';iframe.src='https://www.google.com/maps?q=-42.4793067,-73.7607173&z=17&output=embed';holder.replaceWith(iframe)})};const initCopy=()=>{const button=document.querySelector('[data-copy-address]');const status=document.querySelector('[data-copy-status]');if(!(button instanceof HTMLButtonElement)||!(status instanceof HTMLElement)||button.dataset.ready)return;button.dataset.ready='1';button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(button.dataset.address||'');status.textContent='Dirección copiada.'}catch{status.textContent='No se pudo copiar. Selecciona la dirección mostrada arriba.'}})};document.addEventListener('astro:page-load',()=>{initMap();initCopy()});initMap();initCopy();</script></BaseLayout>
