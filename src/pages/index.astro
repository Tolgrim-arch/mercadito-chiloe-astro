---
import BaseLayout from '../layouts/BaseLayout.astro';
import Accordion from '../components/Accordion.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { restaurant } from '../data/restaurant';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const faqs=[
  ['¿Qué es El Mercadito de Chiloé?','Un restaurante ubicado en Castro, con una carta inspirada en productos del mar, el campo y preparaciones chilotas.'],
  ['¿Dónde está?','En Pedro Montt 210, Castro, Chiloé. Puedes abrir la ubicación exacta en Google Maps desde esta página.'],
  ['¿Cómo hago una reserva real?',`Llama al ${restaurant.phoneDisplay} o usa el WhatsApp oficial. El formulario de esta web es sólo una demostración académica.`]
];
const reviews = [
  ['María González', 'La atención fue muy cálida y la comida estaba deliciosa. Un lugar precioso para volver.', 'Hace 2 semanas'],
  ['Carlos Muñoz', 'Sabores auténticos de Chiloé, porciones generosas y un ambiente inolvidable frente al mar.', 'Hace 1 mes'],
  ['Patricia Rojas', 'Todo estuvo excelente: el pescado, los acompañamientos y la atención del equipo.', 'Hace 1 mes'],
  ['Jorge Pérez', 'Una experiencia muy agradable. La decoración es hermosa y la carta tiene opciones para todos.', 'Hace 2 meses'],
  ['Ana Silva', 'El mejor rincón para disfrutar comida chilota en Castro. Muy recomendado.', 'Hace 2 meses'],
  ['Rodrigo Vargas', 'Productos frescos, preparaciones caseras y un servicio atento de principio a fin.', 'Hace 3 meses'],
];
const dishImages = ['amburgesa-papafritas','carne-con-puredepapas','curanto','mariscos-con-papafritas','mariscos','ostras','palta','pulpo','sopa','vinos'];
---
<BaseLayout title="El Mercadito de Chiloé | Restaurante en Castro" description="Conoce El Mercadito de Chiloé: restaurante en Castro con cocina de mar y campo, carta, ubicación y guía para planificar tu visita.">
  <link slot="head" rel="preload" as="image" type="image/webp" href={`${base}/images/mercadito/hero/portada-inicio.webp`} />
  <section class="home-hero relative isolate flex items-center" aria-labelledby="home-title">
    <div class="home-copy mx-auto w-full max-w-7xl px-5 lg:px-8">
      <p class="mb-5 text-sm font-bold uppercase tracking-[.14em] text-terracotta">Restaurante · Castro, Chiloé</p>
      <h1 id="home-title" class="font-serif text-[clamp(2.75rem,4.8vw,4.75rem)] font-medium leading-[1.06] tracking-[-.035em]">Sabores del sur,<br /><em class="text-terracotta">con identidad<br class="hidden lg:block" /> propia.</em></h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-forest">Cocina de mar, campo y productos chilotes. Una mesa para disfrutar de Chiloé en el corazón de Castro.</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="inline-flex min-h-12 items-center justify-center rounded-full bg-terracotta px-6 font-bold text-white transition hover:bg-terracotta-dark" href={`${base}/carta/`}>Explorar la carta</a>
        <a class="inline-flex min-h-12 items-center justify-center rounded-full border border-forest/30 px-6 font-bold text-forest transition hover:bg-cream" href={`${base}/encuentranos/`}>Cómo llegar</a>
      </div>
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-4 border-t border-forest/15 pt-5 text-base">
        <p><strong class="block">{restaurant.address}</strong><span class="text-forest/80">Visítanos en Castro</span></p>
        <a class="inline-flex min-h-11 items-center font-bold underline decoration-forest/30 underline-offset-4" href={restaurant.phoneHref}>{restaurant.phoneDisplay}</a>
      </div>
    </div>
    <aside class="reviews-carousel absolute bottom-6 right-16 z-10 hidden w-[min(22rem,calc(100%-5rem))] lg:block" aria-label="Reseñas destacadas de visitantes" data-reviews-carousel>
      <div class="review-card rounded-2xl border border-white/75 bg-white/92 p-5 shadow-[0_18px_45px_rgba(25,55,47,0.2)] backdrop-blur-xl" data-review-card aria-live="polite">
        <div class="flex items-start justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-[#e8f0fe] text-[#4285f4]" aria-hidden="true">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.25"/><path d="M5.5 20c.8-3.2 3-5 6.5-5s5.7 1.8 6.5 5"/></svg>
            </span>
            <div><strong class="block text-sm text-forest" data-review-name>{reviews[0][0]}</strong><span class="block text-xs text-forest/55" data-review-date>{reviews[0][2]}</span></div>
          </div>
          <span class="text-xs font-semibold text-forest/55">Google</span>
        </div>
        <div class="mt-4 flex items-center gap-1 text-[#fbbc04]" aria-label="5 de 5 estrellas" data-review-stars>
          {Array.from({ length: 5 }).map(() => <svg class="size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg>)}
        </div>
        <p class="mt-3 min-h-[4.5rem] text-sm leading-relaxed text-forest/80" data-review-text>{reviews[0][1]}</p>
        <div class="mt-4 flex items-center justify-between border-t border-forest/10 pt-3"><span class="text-xs text-forest/50">Reseña verificada</span><div class="flex gap-1" aria-label="Navegar reseñas"><button type="button" class="grid size-8 place-items-center rounded-full border border-forest/15 text-forest transition hover:bg-cream" aria-label="Reseña anterior" data-review-prev>←</button><button type="button" class="grid size-8 place-items-center rounded-full border border-forest/15 text-forest transition hover:bg-cream" aria-label="Siguiente reseña" data-review-next>→</button></div></div>
      </div>
      <div class="mt-2 h-1 overflow-hidden rounded-full bg-white/25" aria-hidden="true"><span class="review-progress block h-full origin-left rounded-full bg-white" data-review-progress></span></div>
    </aside>
    <figure class="home-photo absolute inset-0 -z-20 bg-cream" style={`background-image: url('${base}/images/mercadito/hero/portada-inicio-placeholder.webp')`}>
      <img src={`${base}/images/mercadito/hero/portada-inicio.webp`} width="1676" height="939" alt="Comedor de El Mercadito de Chiloé, con mesas coloridas y decoración de madera" fetchpriority="high" decoding="async" class="is-loading aspect-[4/3] w-full object-cover lg:aspect-[1.08]" onload="this.classList.remove('is-loading')"/>
    </figure>
  </section>
  <section id="identidad" class="dish-marquee scroll-mt-36 overflow-hidden bg-forest py-14 text-white" aria-labelledby="dish-marquee-title">
    <div class="mx-auto mb-8 max-w-7xl px-5 text-center lg:px-8"><p class="text-xs font-bold uppercase tracking-[.18em] text-yellow">Sabores del sur</p><h2 id="dish-marquee-title" class="mt-2 font-serif text-3xl md:text-4xl">Platos para compartir.</h2></div>
    <div class="space-y-4" data-marquee>
      <div class="dish-track flex w-max gap-4" data-track="left">{[...dishImages, ...dishImages].map((name) => <figure class="dish-tile relative size-36 shrink-0 overflow-hidden rounded-2xl border border-white/15 bg-white/10 sm:size-44"><img src={`${base}/images/mercadito/platillos/${name}.webp`} width="320" height="240" loading="lazy" decoding="async" alt={`Plato ${name.replaceAll('-', ' ')}`} class="size-full object-cover" /></figure>)}</div>
      <div class="dish-track dish-track-right flex w-max gap-4" data-track="right">{[...dishImages.slice(5), ...dishImages, ...dishImages.slice(0, 5)].map((name) => <figure class="dish-tile relative size-36 shrink-0 overflow-hidden rounded-2xl border border-white/15 bg-white/10 sm:size-44"><img src={`${base}/images/mercadito/platillos/${name}.webp`} width="320" height="240" loading="lazy" decoding="async" alt={`Plato ${name.replaceAll('-', ' ')}`} class="size-full object-cover" /></figure>)}</div>
    </div>
    <div class="dish-debug mx-auto mt-8 hidden max-w-7xl items-center justify-center gap-3 px-5 text-xs text-white/75" data-marquee-debug><label>Velocidad <input class="w-24" type="range" min="8" max="60" value="28" data-speed /></label><button class="rounded-full border border-white/20 px-3 py-1" type="button" data-direction>Invertir filas</button></div>
  </section>
  <section id="ubicacion" class="scroll-mt-36 bg-cream py-20" aria-labelledby="ubicacion-titulo"><div class="mx-auto max-w-7xl px-5 lg:px-8"><div data-reveal class="mb-10 grid gap-6 md:grid-cols-[1fr_.65fr] md:items-end"><div><p class="text-sm font-bold uppercase tracking-[.16em] text-terracotta">Encuéntranos en Castro</p><h2 id="ubicacion-titulo" class="mt-3 max-w-3xl font-serif text-4xl leading-tight md:text-6xl">A pasos del centro y frente al mar.</h2></div><p class="text-lg leading-relaxed text-forest/70">Visítanos en {restaurant.address}. Abre el mapa para obtener indicaciones desde tu ubicación.</p></div><div data-reveal class="grid overflow-hidden rounded-[2rem] border border-white/70 bg-white/55 shadow-[0_20px_60px_rgba(25,55,47,0.14)] backdrop-blur-xl lg:grid-cols-[1fr_2fr]"><div class="flex flex-col justify-center p-7 sm:p-9"><p class="text-xs font-bold uppercase tracking-[.16em] text-terracotta">Dirección oficial</p><h3 class="mt-3 font-serif text-3xl">{restaurant.address}</h3><a class="mt-5 font-bold text-forest hover:text-terracotta" href={restaurant.phoneHref}>{restaurant.phoneDisplay}</a><div class="mt-7 flex flex-wrap gap-3"><a class="inline-flex min-h-12 items-center rounded-full bg-forest px-6 font-bold text-white hover:-translate-y-0.5 hover:bg-terracotta" href={restaurant.maps} target="_blank" rel="noreferrer">Abrir en Google Maps ↗</a><a class="inline-flex min-h-12 items-center rounded-full border border-forest/20 px-6 font-bold hover:border-terracotta hover:text-terracotta" href={`${base}/encuentranos/`}>Ver detalles</a></div></div><MapEmbed /></div></div></section>
  <section id="preguntas" class="mx-auto grid max-w-7xl scroll-mt-36 gap-10 px-5 py-20 lg:grid-cols-[.7fr_1fr] lg:px-8"><div data-reveal><p class="text-sm font-bold uppercase tracking-[.16em] text-terracotta">Antes de venir</p><h2 class="mt-3 font-serif text-4xl md:text-6xl">Respuestas rápidas.</h2><p class="mt-5 text-lg leading-relaxed text-forest/70">Lo esencial para saber qué es el lugar, dónde encontrarlo y cómo contactar.</p><a class="mt-7 inline-flex min-h-12 items-center rounded-full bg-forest px-6 font-bold text-white" href={`${base}/planifica-tu-visita/`}>Planifica tu visita</a></div><Accordion items={faqs.map(([question, answer]) => ({ question, answer }))} /></section>
  <style>
    .home-hero { margin-top: -4rem; min-height: 100svh; padding-block: 6rem 4rem; }
    .home-hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, #fbfaf6 0%, rgb(251 250 246 / .96) 24%, rgb(251 250 246 / .88) 40%, rgb(251 250 246 / .25) 65%, transparent 82%); }
      .home-photo { background-position: center; background-size: cover; background-repeat: no-repeat; filter: saturate(.98); }
      .home-photo img { width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; object-position: center; opacity: 1; transition: opacity 180ms ease-out; }
      .home-photo img.is-loading { opacity: 0; }
    .review-card { will-change: transform, opacity; }
    .review-card.review-card-exit { animation: review-card-exit 360ms cubic-bezier(.4,0,1,1) forwards; }
    .review-card.review-card-enter { animation: review-card-enter 460ms cubic-bezier(0,0,.2,1) both; }
    .review-progress { animation: review-progress-countdown 6s linear both; }
    .review-progress.review-progress-refresh { animation: review-progress-refresh 320ms cubic-bezier(.22,1,.36,1) both; }
    .reviews-carousel:hover .review-progress, .reviews-carousel:focus-within .review-progress { animation-play-state: paused; }
    @keyframes review-card-exit { to { opacity: 0; transform: translate3d(-28px, 0, 0) scale(.94); } }
    @keyframes review-card-enter { from { opacity: 0; transform: translate3d(28px, 0, 0) scale(.94); } to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); } }
    @keyframes review-progress-countdown { from { transform: scaleX(1); } to { transform: scaleX(0); } }
    @keyframes review-progress-refresh { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    @media (prefers-reduced-motion: reduce) { .review-card { animation: none; } }
    .home-copy > p, .home-copy > h1, .home-copy > div { max-width: 34rem; }
    .home-copy h1 { font-size: clamp(2.6rem, 4.5vw, 4.5rem); }
    .dish-track { animation: dish-marquee-left 28s linear infinite; }
    .dish-track-right { animation-name: dish-marquee-right; }
    .dish-tile img { transition: transform .5s ease, filter .5s ease; }
    .dish-tile:hover img { transform: scale(1.06); filter: saturate(1.1); }
    @keyframes dish-marquee-left { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    @keyframes dish-marquee-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }
    @media (prefers-reduced-motion: reduce) { .dish-track { animation-play-state: paused; } }
    @media (max-width: 640px) { .home-hero { padding-block: 6rem 5rem; } .home-hero::before { background: linear-gradient(90deg, rgb(251 250 246 / .97), rgb(251 250 246 / .86)); } }
  </style>
  <script>
    const reviews = [
      ['María González', 'La atención fue muy cálida y la comida estaba deliciosa. Un lugar precioso para volver.', 'Hace 2 semanas'],
      ['Carlos Muñoz', 'Sabores auténticos de Chiloé, porciones generosas y un ambiente inolvidable frente al mar.', 'Hace 1 mes'],
      ['Patricia Rojas', 'Todo estuvo excelente: el pescado, los acompañamientos y la atención del equipo.', 'Hace 1 mes'],
      ['Jorge Pérez', 'Una experiencia muy agradable. La decoración es hermosa y la carta tiene opciones para todos.', 'Hace 2 meses'],
      ['Ana Silva', 'El mejor rincón para disfrutar comida chilota en Castro. Muy recomendado.', 'Hace 2 meses'],
      ['Rodrigo Vargas', 'Productos frescos, preparaciones caseras y un servicio atento de principio a fin.', 'Hace 3 meses'],
    ];
    const initReviews = () => {
      document.querySelectorAll('[data-reviews-carousel]:not([data-ready])').forEach((carousel) => {
        const card = carousel.querySelector('[data-review-card]');
        const name = carousel.querySelector('[data-review-name]');
        const date = carousel.querySelector('[data-review-date]');
        const text = carousel.querySelector('[data-review-text]');
        const prev = carousel.querySelector('[data-review-prev]');
        const next = carousel.querySelector('[data-review-next]');
        const progress = carousel.querySelector('[data-review-progress]');
        if (!(card instanceof HTMLElement) || !(name instanceof HTMLElement) || !(date instanceof HTMLElement) || !(text instanceof HTMLElement) || !(prev instanceof HTMLButtonElement) || !(next instanceof HTMLButtonElement) || !(progress instanceof HTMLElement)) return;
        let index = 0;
        let timer;
        const render = (nextIndex) => {
          index = (nextIndex + reviews.length) % reviews.length;
          const [reviewer, comment, published] = reviews[index];
          name.textContent = reviewer;
          text.textContent = comment;
          date.textContent = published;
        };
        let transitioning = false;
        const resetProgress = () => {
          progress.classList.remove('review-progress');
          void progress.offsetWidth;
          progress.classList.add('review-progress-refresh');
          window.setTimeout(() => {
            progress.classList.remove('review-progress-refresh');
            void progress.offsetWidth;
            progress.classList.add('review-progress');
          }, 320);
        };
        const changeReview = (nextIndex) => {
          if (transitioning) return;
          transitioning = true;
          card.classList.remove('review-card-enter');
          card.classList.add('review-card-exit');
          window.setTimeout(() => {
            render(nextIndex);
            card.classList.remove('review-card-exit');
            card.classList.add('review-card-enter');
            resetProgress();
            transitioning = false;
          }, 360);
        };
        const restart = () => { window.clearInterval(timer); progress.style.animationPlayState = 'running'; timer = window.setInterval(() => changeReview(index + 1), 6000); };
        prev.addEventListener('click', () => { changeReview(index - 1); restart(); });
        next.addEventListener('click', () => { changeReview(index + 1); restart(); });
        carousel.addEventListener('mouseenter', () => { window.clearInterval(timer); progress.style.animationPlayState = 'paused'; });
        carousel.addEventListener('mouseleave', restart);
        carousel.addEventListener('focusin', () => { window.clearInterval(timer); progress.style.animationPlayState = 'paused'; });
        carousel.addEventListener('focusout', (event) => { if (!carousel.contains(event.relatedTarget)) restart(); });
        carousel.dataset.ready = 'true';
        restart();
      });
    };
    document.addEventListener('astro:page-load', initReviews);
    initReviews();
  </script>
  <script>
    const initDishMarquee = () => {
      const section = document.querySelector('[data-marquee]');
      if (!(section instanceof HTMLElement) || section.dataset.ready) return;
      section.dataset.ready = 'true';
      const debug = new URLSearchParams(window.location.search).get('debug') === '1';
      const debugPanel = document.querySelector('[data-marquee-debug]');
      const speed = document.querySelector('[data-speed]');
      const direction = document.querySelector('[data-direction]');
      if (debugPanel instanceof HTMLElement && debug) debugPanel.classList.add('flex');
      const tracks = [...section.querySelectorAll('[data-track]')].filter((track): track is HTMLElement => track instanceof HTMLElement);
      const applySpeed = () => { const seconds = Number(speed instanceof HTMLInputElement ? speed.value : 28); tracks.forEach((track) => { track.style.animationDuration = `${seconds}s`; }); };
      speed?.addEventListener('input', applySpeed);
      direction?.addEventListener('click', () => tracks.forEach((track) => track.classList.toggle('dish-track-right')));
      applySpeed();
    };
    document.addEventListener('astro:page-load', initDishMarquee);
    initDishMarquee();
  </script>
</BaseLayout>
