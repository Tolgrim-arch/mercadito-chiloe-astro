---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/tailwind.css';
const dishes=[['Curanto en olla','Mariscos, carnes y papas chilotas','$18.900','https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=900&q=85'],['Papas nativas','Mantequilla de ajo chilote y merkén','$7.900','https://images.unsplash.com/photo-1518977676601-b53f82aba655?auto=format&fit=crop&w=900&q=85'],['Salmón de la isla','Cocción lenta, nalca y caldo ahumado','$21.900','https://images.unsplash.com/photo-1467003909585-2f8a72700288?auto=format&fit=crop&w=900&q=85']];
---
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Mercadito de Chiloé: cocina de la isla, productos locales y sobremesa frente al mar." /><title>Mercadito de Chiloé | Cocina de la isla</title><ClientRouter /></head><body><SiteHeader /><main><section class="mx-auto grid max-w-[1240px] items-center gap-12 px-6 py-20 md:grid-cols-2 md:gap-24 md:px-[5vw] md:py-24"><div><p class="mb-7 text-[11px] font-bold uppercase tracking-[.14em] text-orange">● Cocina de la isla · Castro, Chiloé</p><h1 class="m-0 max-w-xl font-serif text-6xl font-medium leading-[.94] tracking-[-.06em] md:text-8xl">El sabor de Chiloé,<br /><i class="text-orange">servido sin apuro.</i></h1><p class="mt-7 max-w-md text-lg leading-relaxed text-ink/75">Un comedor de barrio para encontrarse con los productos, las historias y la calidez del archipiélago.</p><div class="mt-8 flex flex-wrap items-center gap-6"><a class="inline-flex items-center gap-5 rounded bg-orange px-5 py-4 text-sm font-bold text-white hover:bg-[#c95529]" href="#carta">Conoce la carta ↓</a><a class="border-b border-ink pb-1 text-sm font-bold" href="/nosotros">Conoce nuestra historia <span class="text-orange">↗</span></a></div><div class="mt-16 flex gap-10 border-t border-ink/15 pt-4 text-xs"><span><strong class="block">12:30 — 22:30</strong><small class="text-ink/55">Martes a domingo</small></span><span><strong class="block">+56 9 8765 4321</strong><small class="text-ink/55">Reservas y consultas</small></span></div></div><div class="relative"><div class="aspect-[.9] rotate-2 bg-cover bg-center [clip-path:polygon(8%_0,100%_6%,93%_100%,0_94%)]" style="background-image:url('https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1200&q=90')"></div><div class="absolute right-0 top-12 grid size-28 rotate-6 place-items-center rounded-full bg-yellow text-center font-serif text-lg leading-none">Hecho<br /><i>en la isla</i><br />✳</div></div></section><section id="historia" class="grid gap-8 bg-cream px-6 py-24 md:grid-cols-[.3fr_1fr] md:px-[10vw]"><p class="text-[11px] font-bold uppercase tracking-[.14em] text-orange">01 / El lugar</p><div class="max-w-2xl"><h2 class="font-serif text-5xl font-medium leading-none tracking-[-.05em] md:text-7xl">Una mesa puesta para<br /><i class="text-orange">compartir lo nuestro.</i></h2><p class="mt-8 text-lg leading-relaxed text-ink/70">Cocinamos con papas de colores, mariscos de la costa, hierbas del patio y recetas que pasan de generación en generación.</p></div></section><section id="carta" class="px-6 py-24 md:px-[10vw]"><div class="mb-12 flex items-end justify-between"><div><p class="text-[11px] font-bold uppercase tracking-[.14em] text-orange">02 / La carta</p><h2 class="mt-5 font-serif text-5xl font-medium leading-none tracking-[-.05em] md:text-7xl">De la tierra<br /><i class="text-orange">al plato.</i></h2></div><a class="border-b border-ink pb-1 text-sm font-bold" href="/carta">Ver carta completa ↗</a></div><div class="grid gap-5 md:grid-cols-3">{dishes.map(([name,note,price,image])=><article class="bg-cream"><div class="aspect-square bg-cover bg-center" style={`background-image:url('${image}')`}></div><div class="flex justify-between gap-4 p-5"><div><h3 class="font-serif text-2xl">{name}</h3><p class="mt-1 text-xs text-ink/55">{note}</p></div><strong class="text-orange">{price}</strong></div></article>)}</div></section><section class="bg-ink px-6 py-24 text-white md:px-[10vw]"><span class="font-serif text-7xl text-yellow">“</span><blockquote class="max-w-3xl font-serif text-4xl leading-tight tracking-[-.04em] md:text-6xl">Comer aquí es como llegar a la casa de alguien que cocina muy bien.</blockquote><cite class="mt-6 block text-xs not-italic text-white/60">— Camila R. · Google Maps</cite></section><section id="visitanos" class="grid items-center gap-12 px-6 py-24 md:grid-cols-2 md:px-[10vw]"><div class="min-h-[420px] bg-cover bg-center" style="background-image:url('https://images.unsplash.com/photo-1528698827591-e19ccd7bc23d?auto=format&fit=crop&w=1100&q=85')"></div><div><p class="text-[11px] font-bold uppercase tracking-[.14em] text-orange">03 / Visítanos</p><h2 class="mt-5 font-serif text-5xl leading-none tracking-[-.05em] md:text-7xl">Nos vemos en<br /><i class="text-orange">el mercado.</i></h2><p class="mt-8 max-w-md text-lg leading-relaxed text-ink/70">Blanco Encalada 123<br />Castro, Chiloé · Chile</p><a class="mt-7 inline-flex rounded bg-ink px-5 py-4 text-sm font-bold text-white" href="/encuentranos">Cómo llegar ↗</a></div></section><section class="grid gap-8 bg-yellow px-6 py-20 md:grid-cols-2 md:px-[10vw]"><h2 class="font-serif text-5xl leading-none tracking-[-.05em] md:text-7xl">La sobremesa<br /><i>empieza aquí.</i></h2><div><p class="max-w-md text-lg leading-relaxed">Para grupos de 8 personas o más, escríbenos directamente. Para mesas pequeñas, reserva en línea.</p><a class="mt-6 inline-flex rounded bg-ink px-5 py-4 text-sm font-bold text-white" href="/reservas">Reservar mesa ↗</a></div></section></main><SiteFooter /></body></html>
