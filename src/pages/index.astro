---
import BaseLayout from '../layouts/BaseLayout.astro'; import ProgressiveHeroImage from '../components/ProgressiveHeroImage.astro'; import { restaurant, featuredDishes } from '../data/restaurant';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<BaseLayout title="El Mercadito de Chiloé | Restaurante en Castro"><link slot="head" rel="preload" as="image" type="image/avif" href={`${base}/images/mercadito/hero/hero-768.avif`} imagesrcset={`${base}/images/mercadito/hero/hero-480.avif 480w, ${base}/images/mercadito/hero/hero-768.avif 768w`} imagesizes="(min-width: 768px) 50vw, 100vw" fetchpriority="high" /><section class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-14 md:grid-cols-2 lg:px-8 lg:py-20"><div data-reveal><p class="mb-5 text-sm font-bold uppercase tracking-[.16em] text-terracotta">Restaurante · Castro, Chiloé</p><h1 class="max-w-2xl font-serif text-[clamp(3.3rem,8vw,6.5rem)] font-medium leading-[.94] tracking-[-.055em]">Sabores del sur,<br /><em class="text-terracotta">con identidad propia.</em></h1><p class="mt-7 max-w-xl text-lg leading-relaxed text-forest/75">Una cocina de mar, campo y productos chilotes en Pedro Montt 210, frente a la vida cotidiana de Castro.</p><div class="mt-8 flex flex-wrap gap-3"><a class="inline-flex min-h-12 items-center rounded-full bg-terracotta px-6 font-bold text-white transition hover:-translate-y-0.5 hover:bg-terracotta-dark" href={`${base}/carta/`}>Explorar la carta</a><a class="inline-flex min-h-12 items-center rounded-full border border-forest/20 px-6 font-bold transition hover:border-terracotta hover:text-terracotta" href={`${base}/encuentranos/`}>Cómo llegar</a></div><div class="mt-10 grid gap-3 border-t border-forest/15 pt-5 sm:grid-cols-2"><p><strong class="block">{restaurant.address}</strong><span class="text-sm text-forest/60">Ubicación oficial</span></p><p><strong class="block">{restaurant.phoneDisplay}</strong><span class="text-sm text-forest/60">Consultas y reservas reales</span></p></div></div><figure class="relative"><ProgressiveHeroImage /><figcaption class="absolute bottom-5 left-5 z-10 rounded-full bg-yellow px-5 py-3 font-bold">Cocina del archipiélago</figcaption></figure></section>
<section class="bg-forest py-20 text-white"><div class="mx-auto grid max-w-7xl gap-10 px-5 md:grid-cols-[.45fr_1fr] lg:px-8" data-reveal><p class="text-sm font-bold uppercase tracking-[.16em] text-yellow">El lugar</p><div><h2 class="font-serif text-4xl leading-tight md:text-6xl">Una mesa donde el mar y el campo chilote se encuentran.</h2><p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/70">El restaurante propone platos generosos, productos del sur y un espacio lleno de objetos, color y memoria local.</p><a class="mt-7 inline-flex min-h-11 items-center border-b border-yellow font-bold text-yellow" href={`${base}/nosotros/`}>Conoce el lugar →</a></div></div></section>
<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8" id="platos"><div data-reveal class="mb-10 flex flex-wrap items-end justify-between gap-5"><div><p class="text-sm font-bold uppercase tracking-[.16em] text-terracotta">Carta oficial</p><h2 class="mt-3 font-serif text-4xl md:text-6xl">Platos para empezar a mirar.</h2></div><a class="font-bold underline decoration-terracotta decoration-2 underline-offset-8" href={`${base}/carta/`}>Ver carta completa</a></div><div class="grid gap-5 md:grid-cols-3">{featuredDishes.map((dish,i)=><article data-reveal class="rounded-3xl bg-cream p-6 transition hover:-translate-y-1 hover:shadow-xl"><p class="text-xs font-bold uppercase tracking-wider text-terracotta">{dish.category}</p><h3 class="mt-3 font-serif text-3xl">{dish.name}</h3><p class="mt-3 leading-relaxed text-forest/70">{dish.description}</p><strong class="mt-6 block text-lg">{dish.price}</strong></article>)}</div><p class="mt-6 text-sm text-forest/55">Precios consultados en la carta oficial. Pueden cambiar sin previo aviso.</p></section>
<section class="bg-cream py-20" aria-labelledby="ubicacion-inicio">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div data-reveal class="mb-10 grid gap-6 md:grid-cols-[1fr_.65fr] md:items-end">
      <div>
        <p class="text-sm font-bold uppercase tracking-[.16em] text-terracotta">Encuéntranos en Castro</p>
        <h2 id="ubicacion-inicio" class="mt-3 max-w-3xl font-serif text-4xl leading-tight md:text-6xl">A pasos del centro y frente al mar.</h2>
      </div>
      <p class="text-lg leading-relaxed text-forest/70">Visítanos en {restaurant.address}. Abre el mapa para obtener indicaciones desde tu ubicación.</p>
    </div>
    <div data-reveal class="grid overflow-hidden rounded-[2rem] border border-white/70 bg-white/55 shadow-[0_20px_60px_rgba(25,55,47,0.14)] backdrop-blur-xl lg:grid-cols-[1fr_2fr]">
      <div class="flex flex-col justify-center p-7 sm:p-9">
        <p class="text-xs font-bold uppercase tracking-[.16em] text-terracotta">Dirección oficial</p>
        <h3 class="mt-3 font-serif text-3xl">{restaurant.address}</h3>
        <a class="mt-5 font-bold text-forest transition hover:text-terracotta" href={restaurant.phoneHref}>{restaurant.phoneDisplay}</a>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="inline-flex min-h-12 items-center rounded-full bg-forest px-6 font-bold text-white transition hover:-translate-y-0.5 hover:bg-terracotta" href={restaurant.maps} target="_blank" rel="noreferrer">Abrir en Google Maps ↗</a>
          <a class="inline-flex min-h-12 items-center rounded-full border border-forest/20 px-6 font-bold transition hover:border-terracotta hover:text-terracotta" href={`${base}/encuentranos/`}>Ver detalles</a>
        </div>
      </div>
      <div class="bg-forest/5 p-2 lg:p-3">
        <iframe class="min-h-[360px] w-full lg:min-h-[456px]" src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d1471.2948318499068!2d-73.7612275!3d-42.4790151!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x962219e4bb0ac893%3A0x4e0473bf6e49d021!2sEl%20Mercadito%20de%20Chilo%C3%A9!5e0!3m2!1ses-419!2scl!4v1793911011318!5m2!1ses-419!2scl" title="Mapa de El Mercadito de Chiloé en Castro" loading="lazy" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
    </div>
  </div>
</section>
<section class="py-20"><div class="mx-auto grid max-w-7xl items-center gap-10 px-5 md:grid-cols-2 lg:px-8"><img data-reveal class="aspect-[4/3] w-full rounded-3xl object-cover" src={`${base}/images/mercadito/ambiente-03.jpg`} alt="Interior decorado de El Mercadito de Chiloé" width="1024" height="768" loading="lazy" /><div data-reveal><p class="text-sm font-bold uppercase tracking-[.16em] text-terracotta">Prepara tu visita</p><h2 class="mt-3 font-serif text-4xl md:text-6xl">Todo lo importante, antes de llegar.</h2><p class="mt-5 text-lg leading-relaxed text-forest/70">Consulta horarios, ambiente, contacto y respuestas prácticas en una sola guía.</p><a class="mt-7 inline-flex min-h-12 items-center rounded-full bg-forest px-6 font-bold text-white" href={`${base}/planifica-tu-visita/`}>Planifica tu visita</a></div></div></section></BaseLayout>
