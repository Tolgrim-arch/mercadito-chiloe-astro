---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { restaurant } from '../data/restaurant';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faqs = [
  ['¿Dónde está El Mercadito?', 'En Pedro Montt 210, Castro, Chiloé. La página Cómo llegar contiene el enlace directo a la ficha oficial de Google Maps.'],
  ['¿Cómo puedo reservar de verdad?', `Puedes llamar al ${restaurant.phoneDisplay} o escribir mediante el WhatsApp oficial. El formulario de esta web es únicamente una demostración académica.`],
  ['¿Dónde reviso la carta actualizada?', 'La página Carta presenta una selección auténtica y enlaza la carta oficial de Fudo, donde aparecen los cambios de precio y disponibilidad del día.'],
  ['¿Qué ambiente tiene el lugar?', 'El restaurante combina cocina a la vista, vistas al barrio del puerto, madera nativa y una cuidada ambientación con objetos tradicionales, plantas e ilustraciones de la memoria chilota.']
];
---
<BaseLayout title="Planifica tu visita | El Mercadito de Chiloé" description="Prepara tu visita a El Mercadito de Chiloé con dirección, horarios de referencia, contacto, ambiente y preguntas frecuentes.">
  <section class="bg-yellow py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8" data-reveal>
      <p class="text-sm font-extrabold uppercase tracking-[.18em] text-forest">Guía práctica</p>
      <h1 class="mt-4 max-w-4xl font-serif text-[clamp(3.2rem,7vw,6rem)] leading-[.95] tracking-[-.05em] text-forest">Todo lo que necesitas antes de llegar.</h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-forest/85">Ubicación, horarios, contacto, ambiente y respuestas rápidas para preparar tu experiencia gastronómica en Castro.</p>
    </div>
  </section>

  <SectionNav items={[{href:'#datos',label:'Datos prácticos'},{href:'#ambiente',label:'Ambiente'},{href:'#preguntas',label:'Preguntas frecuentes'}]} />

  <section id="datos" class="mx-auto grid max-w-7xl scroll-mt-36 gap-8 px-5 py-20 md:grid-cols-3 lg:px-8">
    {[['Dirección',restaurant.address],...restaurant.hours.map(h=>[h.days,h.times]),['Contacto',restaurant.phoneDisplay]].map(([label,value])=>(
      <article data-reveal class="rounded-3xl bg-cream p-6 shadow-sm">
        <p class="text-xs font-bold uppercase tracking-wider text-terracotta">{label}</p>
        <p class="mt-3 text-lg font-bold text-forest">{value}</p>
      </article>
    ))}
  </section>

  <section id="ambiente" class="scroll-mt-36 bg-forest py-20 text-white">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 md:grid-cols-2 lg:px-8">
      <div data-reveal class="overflow-hidden rounded-3xl shadow-xl">
        <ResponsiveImage name="ambiente-03" class="aspect-[4/3] w-full rounded-3xl object-cover" alt="Interior de El Mercadito con plantas y objetos tradicionales de cocina" width={1024} height={768} loading="lazy" />
      </div>
      <div data-reveal>
        <p class="text-sm font-bold uppercase tracking-[.16em] text-yellow">El ambiente</p>
        <h2 class="mt-3 font-serif text-4xl md:text-6xl">Color, objetos y cocina a la vista.</h2>
        <p class="mt-5 text-lg leading-relaxed text-white/80">Un espacio íntimo y acogedor decorado con vajilla de época, ilustraciones, plantas y recuerdos locales que rinden tributo a las tradiciones marítimas y campesinas del archipiélago.</p>
      </div>
    </div>
  </section>

  <section id="preguntas" class="mx-auto max-w-4xl scroll-mt-36 px-5 py-20">
    <p class="text-sm font-bold uppercase tracking-[.16em] text-terracotta">Antes de venir</p>
    <h2 class="mt-3 font-serif text-4xl md:text-6xl">Preguntas frecuentes.</h2>
    <div class="mt-8 divide-y divide-forest/15">
      {faqs.map(([q,a],i)=>(
        <details data-reveal class="group py-5" open={i===0}>
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-5 text-lg font-bold text-forest">
            {q}
            <span class="text-2xl text-terracotta transition duration-200 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-4 max-w-2xl leading-relaxed text-forest/75">{a}</p>
        </details>
      ))}
    </div>
    <div class="mt-10 flex flex-wrap gap-4">
      <a class="inline-flex min-h-12 items-center rounded-full bg-forest px-6 font-bold text-white transition hover:bg-terracotta" href={`${base}/encuentranos/`}>Cómo llegar</a>
      <a class="inline-flex min-h-12 items-center rounded-full border border-forest/20 px-6 font-bold text-forest transition hover:border-terracotta hover:text-terracotta" href={`${base}/carta/`}>Explorar la carta</a>
    </div>
  </section>
</BaseLayout>
