---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';
import { restaurant } from '../data/restaurant';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const faqs=[
  ['¿Dónde está El Mercadito?','En Pedro Montt 210, Castro, Chiloé. La página Cómo llegar contiene el enlace directo a la ficha oficial de Google Maps.'],
  ['¿Cómo puedo reservar de verdad?',`Puedes llamar al ${restaurant.phoneDisplay} o escribir mediante el WhatsApp oficial. El formulario de esta web es únicamente una demostración académica.`],
  ['¿Dónde reviso la carta actualizada?','La página Carta presenta una selección y enlaza la carta oficial de Fudo, donde pueden aparecer cambios de precio o disponibilidad.'],
  ['¿Qué ambiente tiene el lugar?','El sitio oficial presenta el restaurante como un espacio donde se encuentran la cocina, el barrio, las vistas y el lugar. Las fotografías muestran una decoración cálida y ecléctica.']
];
---
<BaseLayout title="Planifica tu visita | El Mercadito de Chiloé" description="Prepara tu visita a El Mercadito de Chiloé con dirección, horarios de referencia, contacto, ambiente y preguntas frecuentes.">
  <section class="bg-yellow py-16 lg:py-24"><div class="mx-auto max-w-7xl px-5 lg:px-8" data-reveal><p class="text-sm font-bold uppercase tracking-[.16em] text-terracotta">Guía práctica</p><h1 class="mt-4 max-w-4xl font-serif text-[clamp(3.2rem,7vw,6rem)] leading-[.95] tracking-[-.05em]">Todo lo que necesitas antes de llegar.</h1><p class="mt-7 max-w-2xl text-lg leading-relaxed">Ubicación, horarios, contacto, ambiente y respuestas rápidas para preparar tu visita.</p></div></section>
  <SectionNav items={[{href:'#datos',label:'Datos prácticos'},{href:'#ambiente',label:'Ambiente'},{href:'#preguntas',label:'Preguntas frecuentes'}]} />
  <section id="datos" class="mx-auto grid max-w-7xl scroll-mt-36 gap-8 px-5 py-20 md:grid-cols-3 lg:px-8">{[['Dirección',restaurant.address],...restaurant.hours.map(h=>[h.days,h.times]),['Contacto',restaurant.phoneDisplay]].map(([label,value])=><article data-reveal class="rounded-3xl bg-cream p-6"><p class="text-xs font-bold uppercase tracking-wider text-terracotta">{label}</p><p class="mt-3 text-lg font-bold">{value}</p></article>)}</section>
  <section id="ambiente" class="scroll-mt-36 bg-forest py-20 text-white"><div class="mx-auto grid max-w-7xl items-center gap-10 px-5 md:grid-cols-2 lg:px-8"><img data-reveal class="aspect-[4/3] w-full rounded-3xl object-cover" src={`${base}/images/mercadito/ambiente-03.jpg`} alt="Interior de El Mercadito con plantas y objetos de cocina" width="1024" height="768" loading="lazy" /><div data-reveal><p class="text-sm font-bold uppercase tracking-[.16em] text-yellow">El ambiente</p><h2 class="mt-3 font-serif text-4xl md:text-6xl">Color, objetos y cocina a la vista.</h2><p class="mt-5 text-lg leading-relaxed text-white/70">Las imágenes oficiales muestran un espacio cercano, decorado con vajilla, ilustraciones, plantas y referencias al mar y al territorio.</p></div></div></section>
  <section id="preguntas" class="mx-auto max-w-4xl scroll-mt-36 px-5 py-20"><p class="text-sm font-bold uppercase tracking-[.16em] text-terracotta">Antes de venir</p><h2 class="mt-3 font-serif text-4xl md:text-6xl">Preguntas frecuentes.</h2><div class="mt-8 divide-y divide-forest/15">{faqs.map(([q,a],i)=><details data-reveal class="group py-5" open={i===0}><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-5 text-lg font-bold">{q}<span class="text-2xl text-terracotta transition group-open:rotate-45" aria-hidden="true">+</span></summary><p class="mt-4 max-w-2xl leading-relaxed text-forest/70">{a}</p></details>)}</div><div class="mt-10 flex flex-wrap gap-3"><a class="rounded-full bg-forest px-6 py-4 font-bold text-white" href={`${base}/encuentranos/`}>Cómo llegar</a><a class="rounded-full border border-forest/20 px-6 py-4 font-bold" href={`${base}/carta/`}>Explorar la carta</a></div></section>
</BaseLayout>
