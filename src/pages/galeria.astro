---
import BaseLayout from '../layouts/BaseLayout.astro'; const target=`${import.meta.env.BASE_URL.replace(/\/$/,'')}/planifica-tu-visita/`;
---
<BaseLayout title="Contenido trasladado | El Mercadito de Chiloé" noindex={true}><meta http-equiv="refresh" content={`0;url=${target}`} /><section class="grid min-h-[60vh] place-items-center px-5 py-20 text-center"><div><p class="text-sm font-bold uppercase tracking-wider text-terracotta">Contenido trasladado</p><h1 class="mt-4 font-serif text-5xl">La galería ahora forma parte de Planifica tu visita.</h1><a class="mt-8 inline-flex rounded-full bg-forest px-6 py-4 font-bold text-white" href={target}>Continuar</a></div></section></BaseLayout>
