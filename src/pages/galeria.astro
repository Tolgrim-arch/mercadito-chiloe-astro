---
import BaseLayout from '../layouts/BaseLayout.astro';
const target = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/planifica-tu-visita/`;
---
<BaseLayout title="Contenido trasladado | El Mercadito de Chiloé" description="La antigua galería de El Mercadito de Chiloé fue trasladada a la guía Planifica tu visita." noindex={true}>
  <meta slot="head" http-equiv="refresh" content={`0;url=${target}`} />
  <section class="grid min-h-[60vh] place-items-center px-5 py-20 text-center">
    <div data-reveal>
      <p class="text-sm font-bold uppercase tracking-wider text-terracotta">Contenido trasladado</p>
      <h1 class="mt-4 font-serif text-4xl md:text-5xl">La galería ahora forma parte de Planifica tu visita.</h1>
      <p class="mx-auto mt-4 max-w-md text-forest/75">Hemos unificado las fotografías y el ambiente en nuestra nueva guía práctica de visita.</p>
      <a class="mt-8 inline-flex min-h-12 items-center rounded-full bg-forest px-8 font-bold text-white transition hover:bg-terracotta" href={target}>Continuar a Planifica tu visita</a>
    </div>
  </section>
</BaseLayout>
