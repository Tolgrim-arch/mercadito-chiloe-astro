---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
import Icon from './Icon.astro';
---
<nav data-quick-actions class="fixed inset-x-3 bottom-[max(.75rem,env(safe-area-inset-bottom))] z-40 grid grid-cols-2 gap-2 rounded-2xl border border-white/70 bg-paper/95 p-2 shadow-2xl backdrop-blur-xl lg:hidden" aria-label="Accesos rápidos"><a class="flex min-h-12 items-center justify-center gap-2 rounded-xl bg-cream text-sm font-bold" href={`${base}/carta/`}><Icon name="menu-book" />Ver carta</a><a class="flex min-h-12 items-center justify-center gap-2 rounded-xl bg-forest text-sm font-bold text-white" href={`${base}/encuentranos/`}><Icon name="map-pin" />Cómo llegar</a></nav>
<script>let qaObserver=null;const initQuickActions=()=>{if(qaObserver)qaObserver.disconnect();const bar=document.querySelector('[data-quick-actions]');const footer=document.querySelector('footer');if(!(bar instanceof HTMLElement)||!(footer instanceof HTMLElement))return;qaObserver=new IntersectionObserver(([entry])=>bar.classList.toggle('invisible',entry.isIntersecting),{threshold:.05});qaObserver.observe(footer)};document.addEventListener('astro:page-load',initQuickActions);initQuickActions();</script>
