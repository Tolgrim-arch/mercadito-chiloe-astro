---
import { restaurant } from '../data/restaurant';
import BrandLogo from './BrandLogo.astro';
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/#top`;
const nav = [
  ['El lugar', '/nosotros/'],
  ['Carta', '/carta/'],
  ['Planifica', '/planifica-tu-visita/'],
  ['Cómo llegar', '/encuentranos/']
] as const;
---
<footer transition:persist="site-footer" data-reveal class="mt-auto w-full border-t border-forest/15 bg-paper/95 px-5 pt-8 pb-[max(1.75rem,env(safe-area-inset-bottom))] md:px-[5vw]">
  <div class="mx-auto max-w-[1390px]">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-forest/15 pb-6">
      <a class="flex min-h-11 items-center" href={home} aria-label="El Mercadito de Chiloé, volver al inicio" data-scroll-home>
        <BrandLogo class="text-forest" />
      </a>
      <nav class="hidden items-center gap-4 text-xs font-bold md:flex" aria-label="Navegación del pie">
        {nav.map(([label, path]) => (
          <a class="inline-flex min-h-11 items-center underline-offset-4 transition hover:text-terracotta hover:underline" href={`${base}${path}`}>
            {label}
          </a>
        ))}
      </nav>
      <div class="flex flex-wrap justify-end gap-2">
        <a class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-forest/20 px-3 text-xs font-bold transition hover:border-terracotta hover:text-terracotta" href={restaurant.instagram} target="_blank" rel="noreferrer">
          <span class="grid size-7 place-items-center rounded-full bg-forest/5" aria-hidden="true"><Icon name="instagram" class="size-3.5" /></span>
          Instagram
        </a>
        <a class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-forest/20 px-3 text-xs font-bold transition hover:border-terracotta hover:text-terracotta" href={restaurant.whatsapp} target="_blank" rel="noreferrer">
          <span class="grid size-7 place-items-center rounded-full bg-forest/5" aria-hidden="true"><Icon name="message-circle" class="size-3.5" /></span>
          WhatsApp
        </a>
        <a class="inline-flex min-h-11 items-center gap-1.5 rounded-full bg-forest px-3 text-xs font-bold text-white transition hover:bg-terracotta" href={restaurant.originalSite} target="_blank" rel="noreferrer">
          <span class="grid size-7 place-items-center rounded-full bg-white/10" aria-hidden="true"><Icon name="globe" class="size-3.5" /></span>
          Sitio original
        </a>
      </div>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 pt-4 text-xs text-forest/70">
      <span>© 2026 El Mercadito de Chiloé</span>
      <span class="hidden md:inline">{restaurant.address}</span>
      <a class="inline-flex min-h-11 items-center font-bold text-forest underline-offset-4 transition hover:text-terracotta hover:underline" href="#top" data-scroll-home>
        Volver arriba ↑
      </a>
    </div>
  </div>
</footer>
<script>
  const initFooterScroll = () => {
    document.querySelectorAll('[data-scroll-home]').forEach((link) => {
      if (!(link instanceof HTMLAnchorElement) || link.dataset.scrollReady) return;
      link.dataset.scrollReady = 'true';
      link.addEventListener('click', (event) => {
        const target = new URL(link.href, window.location.href);
        if (target.pathname !== window.location.pathname) return;
        event.preventDefault();
        window.history.replaceState({}, '', target.pathname);
        window.scrollTo({
          top: 0,
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
        });
      });
    });
  };
  document.addEventListener('astro:page-load', initFooterScroll);
  initFooterScroll();
</script>