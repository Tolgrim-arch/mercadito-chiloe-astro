---
import { restaurant } from '../data/restaurant';
import BrandLogo from './BrandLogo.astro';
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/#top`;
const nav = [['El lugar','/nosotros/'],['Carta','/carta/'],['Planifica','/planifica-tu-visita/'],['Cómo llegar','/encuentranos/']] as const;
---
<footer transition:persist="site-footer" data-reveal class="mx-auto max-w-[1390px] px-5 py-3 md:px-[5vw]">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/15 pb-3">
    <a class="flex min-h-11 items-center" href={home} aria-label="El Mercadito de Chiloé, volver al inicio" data-scroll-home><BrandLogo class="text-forest" /></a>
    <nav class="hidden items-center gap-3 text-xs font-bold md:flex" aria-label="Navegación del pie">{nav.map(([label,path])=><a class="inline-flex min-h-11 min-w-11 items-center justify-center underline-offset-4 hover:text-terracotta hover:underline" href={`${base}${path}`}>{label}</a>)}</nav>
    <div class="flex flex-wrap justify-end gap-1.5">
      <a class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-ink/15 px-2.5 text-xs font-bold hover:border-orange hover:text-orange" href={restaurant.instagram} target="_blank" rel="noreferrer"><span class="grid size-7 place-items-center rounded-full bg-ink/5" aria-hidden="true"><Icon name="instagram" class="size-3.5" /></span>Instagram</a>
      <a class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-ink/15 px-2.5 text-xs font-bold hover:border-orange hover:text-orange" href={restaurant.whatsapp} target="_blank" rel="noreferrer"><span class="grid size-7 place-items-center rounded-full bg-ink/5" aria-hidden="true"><Icon name="message-circle" class="size-3.5" /></span>WhatsApp</a>
      <a class="inline-flex min-h-11 items-center gap-1.5 rounded-full bg-ink px-2.5 text-xs font-bold text-white hover:bg-orange" href={restaurant.originalSite} target="_blank" rel="noreferrer"><span class="grid size-7 place-items-center rounded-full bg-white/10" aria-hidden="true"><Icon name="globe" class="size-3.5" /></span>Sitio original</a>
    </div>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 pt-1 text-[11px] text-ink/60">
    <span>© 2026 El Mercadito de Chiloé</span><span class="hidden md:inline">{restaurant.address}</span>
    <a class="inline-flex min-h-11 items-center font-bold text-ink underline-offset-4 hover:underline" href="#top" data-scroll-home>Volver arriba ↑</a>
  </div>
</footer>
<script>
  const initFooterScroll=()=>{document.querySelectorAll('[data-scroll-home]').forEach(link=>{if(!(link instanceof HTMLAnchorElement)||link.dataset.scrollReady)return;link.dataset.scrollReady='true';link.addEventListener('click',event=>{const target=new URL(link.href,window.location.href);if(target.pathname!==window.location.pathname)return;event.preventDefault();window.history.replaceState({},'',target.pathname);window.scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})})})};document.addEventListener('astro:page-load',initFooterScroll);initFooterScroll();
</script>
