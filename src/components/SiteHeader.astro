---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [['/', 'Inicio'], ['/nosotros', 'Nuestra historia'], ['/carta', 'La carta'], ['/galeria', 'Galería'], ['/encuentranos', 'Encuéntranos']];
---
<header transition:persist="site-header" class="sticky top-3 z-30 mx-3 h-[68px] rounded-2xl border border-white/70 bg-white/50 px-6 shadow-[0_12px_34px_rgba(32,59,53,.12),inset_0_1px_0_rgba(255,255,255,.8)] backdrop-blur-2xl backdrop-saturate-150 md:mx-auto md:max-w-[1390px] md:px-[5vw]"><div class="mx-auto flex h-full items-center justify-between gap-8"><a class="flex items-center gap-2 text-[13px] font-bold uppercase leading-none tracking-wide" href={`${import.meta.env.BASE_URL}/`} aria-label="Mercadito de Chiloé, inicio"><span class="grid size-[34px] place-items-center rounded-full bg-orange font-serif text-xl text-white">M</span><span>Mercadito<br /><em class="font-serif text-[15px] font-semibold normal-case">de Chiloé</em></span></a><nav class="hidden items-center gap-7 text-[13px] font-semibold md:flex" aria-label="Navegación principal">{links.map(([href, label]) => <a class:list={["relative py-2 transition-colors hover:text-orange", currentPath === href ? "text-orange after:absolute after:-bottom-1 after:left-0 after:h-0.5 after:w-full after:bg-orange" : "text-ink"]} href={`${import.meta.env.BASE_URL}${href}`} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>)}</nav><a class="inline-flex items-center gap-4 rounded bg-orange px-4 py-3 text-[13px] font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#c95529]" href={`${import.meta.env.BASE_URL}/reservas`}>Reservar mesa <span>↗</span></a></div></header>
