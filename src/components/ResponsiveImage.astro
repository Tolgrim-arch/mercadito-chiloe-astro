---
interface Props {
  name: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
}
const { name, alt, width, height, class: className = '', loading = 'lazy', sizes = '(min-width: 768px) 50vw, 100vw' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const responsive = `${base}/images/mercadito/responsive`;
const srcset = (extension: string) => [480,768,1024].map(size => `${responsive}/${name}-${size}.${extension} ${size}w`).join(', ');
---
<picture>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img class={className} src={`${base}/images/mercadito/${name}.jpg`} srcset={srcset('webp')} sizes={sizes} alt={alt} width={width} height={height} loading={loading} decoding="async" />
</picture>
