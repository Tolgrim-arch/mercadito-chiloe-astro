---
interface Props { name: string; label: string }
const { name, label } = Astro.props;
---

<div class="relative mb-5 grid gap-2 text-xs font-bold" data-date-picker>
  <span>{label}</span>
  <input type="hidden" name={name} data-date-value />
  <button type="button" class="flex w-full items-center justify-between border-0 border-b border-ink/15 bg-transparent p-2 text-left font-sans text-sm font-medium outline-none transition-colors hover:border-orange focus:border-orange" aria-haspopup="dialog" aria-expanded="false" data-date-trigger>
    <span class="text-ink/55" data-date-label>dd-mm-aaaa</span><span class="text-orange">▣</span>
  </button>
  <div class="absolute right-0 top-full z-40 mt-2 hidden w-[280px] max-w-[calc(100vw-3rem)] rounded-lg border border-ink/10 bg-paper p-3 shadow-xl shadow-ink/15" role="dialog" aria-label="Seleccionar fecha" data-date-panel>
    <div class="mb-3 flex items-center justify-between"><button type="button" class="grid size-8 place-items-center rounded-full text-lg hover:bg-orange/10" data-date-prev aria-label="Mes anterior">‹</button><strong class="text-sm" data-date-title></strong><button type="button" class="grid size-8 place-items-center rounded-full text-lg hover:bg-orange/10" data-date-next aria-label="Mes siguiente">›</button></div>
    <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-bold text-ink/45"><span>Lu</span><span>Ma</span><span>Mi</span><span>Ju</span><span>Vi</span><span>Sá</span><span>Do</span></div>
    <div class="mt-2 grid grid-cols-7 gap-1" data-date-grid></div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-date-picker]').forEach((picker) => {
    const trigger = picker.querySelector<HTMLButtonElement>('[data-date-trigger]');
    const panel = picker.querySelector<HTMLElement>('[data-date-panel]');
    const label = picker.querySelector<HTMLElement>('[data-date-label]');
    const value = picker.querySelector<HTMLInputElement>('[data-date-value]');
    const title = picker.querySelector<HTMLElement>('[data-date-title]');
    const grid = picker.querySelector<HTMLElement>('[data-date-grid]');
    const prev = picker.querySelector<HTMLButtonElement>('[data-date-prev]');
    const next = picker.querySelector<HTMLButtonElement>('[data-date-next]');
    if (!trigger || !panel || !label || !value || !title || !grid || !prev || !next) return;
    const view = new Date(); view.setDate(1);
    const monthName = new Intl.DateTimeFormat('es-CL', { month: 'long', year: 'numeric' });
    const format = (date: Date) => `${String(date.getDate()).padStart(2, '0')}-${String(date.getMonth() + 1).padStart(2, '0')}-${date.getFullYear()}`;
    const close = () => { panel.classList.add('hidden'); trigger.setAttribute('aria-expanded', 'false'); };
    const render = () => {
      title.textContent = monthName.format(view).replace(/^./, (char) => char.toUpperCase()); grid.innerHTML = '';
      const offset = (view.getDay() + 6) % 7; const days = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
      for (let i = 0; i < offset; i++) grid.append(document.createElement('span'));
      for (let day = 1; day <= days; day++) {
        const button = document.createElement('button'); button.type = 'button'; button.textContent = String(day); button.className = 'grid aspect-square place-items-center rounded-full text-xs font-medium transition-colors hover:bg-orange hover:text-white';
        button.addEventListener('click', () => { const picked = new Date(view.getFullYear(), view.getMonth(), day); label.textContent = format(picked); label.classList.remove('text-ink/55'); value.value = picked.toISOString().slice(0, 10); close(); }); grid.append(button);
      }
    };
    trigger.addEventListener('click', () => { const open = trigger.getAttribute('aria-expanded') === 'true'; if (open) close(); else { panel.classList.remove('hidden'); trigger.setAttribute('aria-expanded', 'true'); render(); } });
    prev.addEventListener('click', () => { view.setMonth(view.getMonth() - 1); render(); }); next.addEventListener('click', () => { view.setMonth(view.getMonth() + 1); render(); });
    document.addEventListener('click', (event) => { if (!picker.contains(event.target as Node)) close(); });
  });
</script>
