---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const alt = 'Plato de pescado dorado servido en El Mercadito de Chiloé';
---
<div data-progressive-image class="relative aspect-[4/5] w-full overflow-hidden rounded-[2.5rem] bg-cream shadow-2xl">
  <img
    class="absolute inset-0 size-full scale-110 object-cover blur-2xl transition-opacity duration-500"
    src={`${base}/images/mercadito/hero/hero-placeholder.webp`}
    alt=""
    width="32"
    height="36"
    aria-hidden="true"
    data-progressive-placeholder
  />
  <picture>
    <source type="image/avif" srcset={`${base}/images/mercadito/hero/hero-480.avif 480w, ${base}/images/mercadito/hero/hero-768.avif 768w`} sizes="(min-width: 768px) 50vw, 100vw" />
    <source type="image/webp" srcset={`${base}/images/mercadito/hero/hero-480.webp 480w, ${base}/images/mercadito/hero/hero-768.webp 768w, ${base}/images/mercadito/hero/hero-835.webp 835w`} sizes="(min-width: 768px) 50vw, 100vw" />
    <img
      class="relative size-full object-cover opacity-100 transition-opacity duration-500"
      src={`${base}/images/mercadito/exterior-01.jpg`}
      srcset={`${base}/images/mercadito/hero/hero-480.webp 480w, ${base}/images/mercadito/hero/hero-768.webp 768w, ${base}/images/mercadito/hero/hero-835.webp 835w`}
      sizes="(min-width: 768px) 50vw, 100vw"
      alt={alt}
      width="834"
      height="944"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      data-progressive-main
    />
  </picture>
  <!-- Loader adapted from Uiverse.io by cosnametv: spotty-starfish-76 -->
  <div class="absolute inset-0 hidden place-items-center transition-opacity duration-300" data-image-loader aria-hidden="true">
    <div class="grid size-14 grid-cols-3 gap-1.5 rounded-2xl bg-paper/75 p-3 shadow-lg backdrop-blur-md">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
  </div>
</div>
<script>
  const initProgressiveImages = () => {
    document.querySelectorAll('[data-progressive-image]:not([data-progressive-ready])').forEach((container) => {
      if (!(container instanceof HTMLElement)) return;
      const image = container.querySelector('[data-progressive-main]');
      if (!(image instanceof HTMLImageElement)) return;
      const reveal = () => {
        const done = () => container.setAttribute('data-image-ready', '');
        image.decode?.().then(done).catch(done) ?? done();
      };
      container.setAttribute('data-progressive-ready', '');
      if (image.complete) reveal();
      else {
        image.addEventListener('load', reveal, { once: true });
        image.addEventListener('error', () => container.setAttribute('data-image-ready', ''), { once: true });
      }
    });
  };
  document.addEventListener('astro:page-load', initProgressiveImages);
  initProgressiveImages();
</script>
