---
interface Item { href: string; label: string; }
interface Props { items: Item[]; label?: string; }
const { items, label = 'Secciones de esta página' } = Astro.props;
---
<nav class="mx-auto max-w-7xl px-5 py-5 lg:px-8" aria-label={label} data-section-nav>
  <div class="mx-auto flex w-fit max-w-full gap-1 overflow-x-auto rounded-full border border-forest/10 bg-cream/55 p-1 shadow-sm">
    {items.map(({ href, label }) => <a class="inline-flex min-h-10 items-center whitespace-nowrap rounded-full px-3.5 py-1.5 text-sm font-bold text-forest/65 transition hover:bg-paper hover:text-terracotta" href={href}>{label}</a>)}
  </div>
</nav>
<script>
  let sectionObservers = [];
  const initSectionNavs = () => {
    sectionObservers.forEach((obs) => obs.disconnect());
    sectionObservers = [];
    document.querySelectorAll('[data-section-nav]:not([data-ready])').forEach((nav) => {
      if (!(nav instanceof HTMLElement)) return;
      nav.dataset.ready = '1';
      const links = [...nav.querySelectorAll('a[href^="#"]')].filter((link) => link instanceof HTMLAnchorElement);
      const sections = links.map((link) => document.querySelector(link.hash)).filter((section) => section instanceof HTMLElement);
      if (!sections.length) return;
      const setActive = (id) => links.forEach((link) => {
        const active = link.hash === `#${id}`;
        link.classList.toggle('bg-cream', active);
        link.classList.toggle('text-terracotta', active);
        active ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current');
      });
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target.id) setActive(visible.target.id);
      }, { rootMargin: '-25% 0px -60% 0px', threshold: [0, .2, .5] });
      sections.forEach((section) => observer.observe(section));
      sectionObservers.push(observer);
      const currentHash = window.location.hash.slice(1);
      const initialTarget = sections.find((s) => s.id === currentHash) || sections[0];
      setActive(initialTarget.id);
    });
  };
  document.addEventListener('astro:page-load', initSectionNavs);
  initSectionNavs();
</script>
