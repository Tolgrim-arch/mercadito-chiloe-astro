---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/tailwind.css';
const { title, description = 'Mercadito de Chiloé: cocina de la isla, productos locales y sobremesa frente al mar.' } = Astro.props;
---
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title}</title><ClientRouter /></head><body><SiteHeader /><main><slot /></main><footer class="mx-auto max-w-[1390px] px-6 pb-6 pt-14 md:px-[5vw]"><div class="flex flex-col gap-8 border-b border-ink/15 pb-16 md:flex-row md:items-start md:justify-between"><a class="flex items-center gap-2 text-[13px] font-bold uppercase leading-none tracking-wide" href="/"><span class="grid size-[34px] place-items-center rounded-full bg-orange font-serif text-xl text-white">M</span><span>Mercadito<br /><em class="font-serif text-[15px] font-semibold normal-case">de Chiloé</em></span></a><p class="m-0 font-serif text-xl leading-tight text-ink/60">Cocina de la isla,<br />con tiempo y cariño.</p><div class="flex gap-3"><a class="grid size-8 place-items-center rounded-full border border-ink/15 text-[11px]" href="https://instagram.com" aria-label="Instagram">IG</a><a class="grid size-8 place-items-center rounded-full border border-ink/15 text-[11px]" href="mailto:hola@mercaditodechiloe.com" aria-label="Correo electrónico">@</a></div></div><div class="flex flex-wrap justify-between gap-3 pt-5 text-[11px] text-ink/55"><span>© 2026 Mercadito de Chiloé</span><span>Hecho en Castro, Chile</span><a class="font-bold text-ink" href="#top">Volver arriba ↑</a></div></footer></body></html>
