---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileQuickActions from '../components/MobileQuickActions.astro';
import BackToTop from '../components/BackToTop.astro';
import { restaurant } from '../data/restaurant';
import '../styles/tailwind.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const {
  title,
  description = 'El Mercadito de Chiloé, restaurante en Castro con cocina inspirada en el mar, la huerta y el territorio.',
  noindex = false
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://tolgrim-arch.github.io');
const fontFaces = `
@font-face{font-family:'DM Sans';src:url('${base}/fonts/dm-400.ttf') format('truetype');font-weight:400;font-display:swap}
@font-face{font-family:'DM Sans';src:url('${base}/fonts/dm-600.ttf') format('truetype');font-weight:600;font-display:swap}
@font-face{font-family:'DM Sans';src:url('${base}/fonts/dm-700.ttf') format('truetype');font-weight:700;font-display:swap}
@font-face{font-family:'Playfair Display';src:url('${base}/fonts/playfair-500.ttf') format('truetype');font-weight:500;font-display:swap}
@font-face{font-family:'Playfair Display';src:url('${base}/fonts/playfair-500-italic.ttf') format('truetype');font-style:italic;font-weight:500;font-display:swap}
@font-face{font-family:'Playfair Display';src:url('${base}/fonts/playfair-600.ttf') format('truetype');font-weight:600;font-display:swap}`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: restaurant.name,
  image: `${Astro.site ?? 'https://tolgrim-arch.github.io'}${base}/images/mercadito/hero/hero-768.webp`,
  url: canonical.toString(),
  telephone: restaurant.phoneDisplay,
  menu: restaurant.officialMenu,
  servesCuisine: ['Chilota', 'Mariscos', 'Pescados', 'Cocina tradicional del sur'],
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Pedro Montt 210',
    addressLocality: 'Castro',
    addressRegion: 'Los Lagos',
    addressCountry: 'CL'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: restaurant.coordinates.latitude,
    longitude: restaurant.coordinates.longitude
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
      opens: '13:00',
      closes: '21:30'
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Friday'],
      opens: '13:00',
      closes: '22:00'
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '14:00',
      closes: '22:00'
    }
  ],
  sameAs: [restaurant.instagram, restaurant.maps, restaurant.originalSite]
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${Astro.site ?? 'https://tolgrim-arch.github.io'}${base}/images/mercadito/hero/hero-768.webp`} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/favicon.svg`} />
    <style is:inline set:html={fontFaces}></style>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
    <link rel="preload" href={`${base}/fonts/dm-400.ttf`} as="font" type="font/ttf" crossorigin />
    <link rel="preload" href={`${base}/fonts/dm-700.ttf`} as="font" type="font/ttf" crossorigin />
    <link rel="preload" href={`${base}/fonts/playfair-500.ttf`} as="font" type="font/ttf" crossorigin />
    <link rel="preload" href={`${base}/fonts/playfair-600.ttf`} as="font" type="font/ttf" crossorigin />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <slot name="head" />
    <ClientRouter />
    <style is:inline>
      #nav-progress{position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,#edc95a,#b84d2d);z-index:9999;width:0%;opacity:0;pointer-events:none;transition:width .2s ease-out,opacity .25s ease-out}
      :is(a.inline-flex,button):not([data-back-to-top]){transition:transform .22s cubic-bezier(.22,1,.36,1),background-color .22s ease,border-color .22s ease,color .22s ease,box-shadow .22s ease}
      :is(a.inline-flex,button):not([data-back-to-top]):hover{transform:scale(1.02)}
      :is(a.inline-flex,button):not([data-back-to-top]):active{transform:scale(.99)}
      @media (prefers-reduced-motion:reduce){:is(a.inline-flex,button):not([data-back-to-top]){transition:none}:is(a.inline-flex,button):not([data-back-to-top]):hover,:is(a.inline-flex,button):not([data-back-to-top]):active{transform:none}}
    </style>
  </head>
  <body id="top" class="bg-paper text-forest antialiased min-h-screen flex flex-col">
    <div id="nav-progress" transition:persist="nav-progress" aria-hidden="true"></div>
    <SiteHeader />
    <main id="contenido" class="flex-1 pb-16 lg:pb-0"><slot /></main>
    <SiteFooter />
    <MobileQuickActions />
    <BackToTop />
    <script>
      document.addEventListener('astro:before-preparation', () => {
        const bar = document.getElementById('nav-progress');
        if (bar) {
          bar.style.opacity = '1';
          bar.style.width = '40%';
        }
      });
      document.addEventListener('astro:after-preparation', () => {
        const bar = document.getElementById('nav-progress');
        if (bar) {
          bar.style.width = '85%';
        }
      });
      document.addEventListener('astro:page-load', () => {
        const bar = document.getElementById('nav-progress');
        if (bar) {
          bar.style.width = '100%';
          setTimeout(() => {
            bar.style.opacity = '0';
            setTimeout(() => { bar.style.width = '0%'; }, 220);
          }, 80);
        }
      });
    </script>
    <script>
      let revealObserver = null;
      const initReveal = () => {
        if (revealObserver) {
          revealObserver.disconnect();
        }
        const items = document.querySelectorAll('[data-reveal]:not([data-reveal-visible])');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
          document.querySelectorAll('[data-reveal]').forEach((el) => el.setAttribute('data-reveal-visible', ''));
          return;
        }
        revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting || entry.intersectionRatio > 0) {
              entry.target.setAttribute('data-reveal-visible', '');
              revealObserver?.unobserve(entry.target);
            }
          });
        }, { threshold: 0.01, rootMargin: '80px 0px 80px 0px' });

        items.forEach((el, index) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight + 80 && rect.bottom > -80) {
            el.setAttribute('data-reveal-visible', '');
            return;
          }
          if (index > 0 && el instanceof HTMLElement) {
            el.style.transitionDelay = `${Math.min((index % 4) * 60, 180)}ms`;
          }
          revealObserver.observe(el);
        });
      };
      document.addEventListener('astro:page-load', initReveal);
      initReveal();
    </script>
    <script>
      const initResponsiveImages = () => {
        const supported = new Set(['exterior-01', 'ambiente-01', 'ambiente-03', 'plato-01', 'plato-02', 'plato-04']);
        document.querySelectorAll('img[src*="/images/mercadito/"]:not([data-progressive-main]):not([data-responsive-ready])').forEach((image) => {
          if (!(image instanceof HTMLImageElement)) return;
          const name = image.src.split('/').pop()?.replace(/\.jpg$/, '');
          if (!name || !supported.has(name)) return;
          const root = image.src.replace(/\/[^/]+\.jpg$/, '/responsive');
          image.srcset = [480, 768, 1024].map((width) => `${root}/${name}-${width}.webp ${width}w`).join(', ');
          image.sizes = image.sizes || '(min-width: 768px) 50vw, 100vw';
          image.decoding = 'async';
          image.dataset.responsiveReady = '1';
        });
      };
      document.addEventListener('astro:page-load', initResponsiveImages);
      initResponsiveImages();
    </script>
  </body>
</html>
